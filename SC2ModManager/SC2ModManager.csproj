<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<OutputType>WinExe</OutputType>
		<TargetFramework>net8.0-windows</TargetFramework>
		<Nullable>enable</Nullable>
		<ImplicitUsings>enable</ImplicitUsings>
		<UseWPF>true</UseWPF>
		<Version>1.4.0</Version>
		<ApplicationIcon>Assets\Supreme_Commander_2_2.ico</ApplicationIcon>
		<RuntimeIdentifier>win-x64</RuntimeIdentifier>
		<SelfContained>true</SelfContained>
		<PublishSingleFile>true</PublishSingleFile>
		<IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
		<EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
		<PublishReadyToRun>true</PublishReadyToRun>
	</PropertyGroup>

  <ItemGroup>
    <None Remove="Assets\SPOILER_profile.png" />
    <None Remove="Assets\uef.png" />
	<None Remove="Assets\Supreme_Commander_2_2.ico"/>
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Assets\spoiler_profile.png" />
    <Resource Include="Assets\uef.png" />
	<Resource Include="Assets\Supreme_Commander_2_2.ico"/>
  </ItemGroup>

</Project>
