<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<OutputType>WinExe</OutputType>
		<TargetFramework>net8.0-windows</TargetFramework>
		<Nullable>enable</Nullable>
		<ImplicitUsings>enable</ImplicitUsings>
		<UseWPF>true</UseWPF>
		<Version>1.6.4</Version>
		<ApplicationIcon>Assets\Supreme_Commander_2_2.ico</ApplicationIcon>
		<RuntimeIdentifier>win-x64</RuntimeIdentifier>
		<SelfContained>true</SelfContained>
		<PublishSingleFile>true</PublishSingleFile>
		<IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
		<EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
		<PublishReadyToRun>true</PublishReadyToRun>

		<EnableLauncher>false</EnableLauncher>
	</PropertyGroup>

	<!-- Turn the EnableLauncher flag above into an ENABLE_LAUNCHER compile constant the code uses. -->
	<PropertyGroup Condition="'$(EnableLauncher)' == 'true'">
		<DefineConstants>$(DefineConstants);ENABLE_LAUNCHER</DefineConstants>
	</PropertyGroup>

	<ItemGroup>
		<None Remove="Assets\spoiler_profile.png" />
		<None Remove="Assets\uef.png" />
		<None Remove="Assets\cybran.png" />
		<None Remove="Assets\aeon.png" />
		<None Remove="Assets\uefacu.png" />
		<None Remove="Assets\cybranacu.png" />
		<None Remove="Assets\aeonacu.png" />
		<None Remove="Assets\Supreme_Commander_2_2.ico" />
	</ItemGroup>

	<ItemGroup>
		<Resource Include="Assets\spoiler_profile.png" />
		<Resource Include="Assets\uef.png" />
		<Resource Include="Assets\cybran.png" />
		<Resource Include="Assets\aeon.png" />
		<Resource Include="Assets\uefacu.png" />
		<Resource Include="Assets\cybranacu.png" />
		<Resource Include="Assets\aeonacu.png" />
		<Resource Include="Assets\Supreme_Commander_2_2.ico"/>
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\SC2ReplayParser\SC2ReplayParser.csproj"/>
	</ItemGroup>

</Project>
