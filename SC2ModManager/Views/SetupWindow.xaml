<Window x:Class="SC2ModManager.SetupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Setup" Height="300" Width="500"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Title -->
        <TextBlock Text="Initial Setup"
               FontSize="20"
               FontWeight="Bold"
               HorizontalAlignment="Center"
               Margin="0,0,0,20"/>

        <!-- Instructions -->
        <TextBlock Grid.Row="1"
               Text="Select your game installation folder."
               Margin="0,0,0,10"/>

        <!-- Folder selection -->
        <StackPanel Grid.Row="2" Orientation="Horizontal">
            <TextBox x:Name="GamePathTextBox"
                 Width="300"
                 IsReadOnly="True"
                 Margin="0,0,10,0"/>
            <Button Content="Browse..." Width="100" Click="Browse_Click"/>
        </StackPanel>

        <!-- Progress -->
        <StackPanel Grid.Row="3" Margin="0,20,0,0">
            <ProgressBar x:Name="SetupProgressBar"
                     Height="20"
                     Minimum="0"
                     Maximum="100"/>

            <TextBlock x:Name="StatusText"
                   Text="Waiting..."
                   Margin="0,5,0,0"/>
        </StackPanel>

        <!-- Finish -->
        <Button Grid.Row="4"
            Content="Finish Setup"
            Height="35"
            Width="150"
            HorizontalAlignment="Center"
            VerticalAlignment="Bottom"
            Click="Finish_Click"/>
    </Grid>
</Window>
