<Window x:Class="SC2ModManager.Views.RenameReplayDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Rename Replay"
        Width="420"
        SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="#0D1117"
        Foreground="White"
        FontFamily="Segoe UI">

    <StackPanel Margin="24,20,24,20">

        <TextBlock Text="Rename Replay"
                   FontSize="17" FontWeight="SemiBold" Foreground="White"
                   Margin="0,0,0,16"/>

        <TextBlock Text="New name (without extension):"
                   Foreground="#AAAAAA" FontSize="13" Margin="0,0,0,6"/>

        <TextBox x:Name="NameBox"
                 FontSize="13"
                 Padding="8,6"
                 Background="#161B22"
                 Foreground="White"
                 BorderBrush="#444C56"
                 BorderThickness="1"
                 CaretBrush="White"
                 Margin="0,0,0,6"
                 KeyDown="NameBox_KeyDown"/>

        <TextBlock x:Name="ErrorText"
                   Foreground="#FF6B6B" FontSize="12"
                   Visibility="Collapsed"
                   Margin="0,0,0,16"
                   TextWrapping="Wrap"/>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button Content="Cancel"
                    Width="80" Height="32" Margin="0,0,8,0"
                    Background="#2D333B" Foreground="White"
                    BorderBrush="#444C56" BorderThickness="1"
                    Cursor="Hand"
                    Click="Cancel_Click"/>
            <Button Content="✓  Rename"
                    Width="100" Height="32"
                    Background="#1E90FF" Foreground="White"
                    BorderThickness="0"
                    FontWeight="SemiBold"
                    Cursor="Hand"
                    Click="Rename_Click"/>
        </StackPanel>

    </StackPanel>
</Window>
