<Window x:Class="SC2ModManager.Views.RestoreGamedataDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Restore Original Game Files"
        Width="520"
        SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="#0D1117"
        Foreground="White"
        FontFamily="Segoe UI">

    <StackPanel Margin="24,20,24,20">

        <!-- Warning icon + title -->
        <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
            <TextBlock Text="⚠" FontSize="22" Foreground="#E3B341" VerticalAlignment="Center" Margin="0,0,10,0"/>
            <TextBlock Text="Restore Original Game Files?"
                       FontSize="17" FontWeight="SemiBold" Foreground="White"
                       VerticalAlignment="Center"/>
        </StackPanel>

        <!-- Warning text -->
        <Border Background="#1C1600" BorderBrush="#856404" BorderThickness="1" CornerRadius="4"
                Padding="14,10" Margin="0,0,0,12">
            <TextBlock Foreground="#E3B341" FontSize="13" TextWrapping="Wrap" LineHeight="20">
                <Run Text="This will delete everything in your gamedata folder and replace it with the original game files. "/>
                <Run Text="Any maps, mods, and hotkey changes currently in gamedata will be lost." FontWeight="Bold"/>
            </TextBlock>
        </Border>

        <TextBlock Foreground="#CCCCCC" FontSize="13" TextWrapping="Wrap" LineHeight="20" Margin="0,0,0,8">
            You can create a backup of your current gamedata first. It saves the exact state of the
            folder so you can restore it later from the Backups screen. Only one of these backups can
            exist at a time, and it uses as much disk space as your gamedata folder.
        </TextBlock>

        <!-- Shown only when a previous full backup already exists -->
        <TextBlock x:Name="ReplaceWarningText"
                   Foreground="#E3B341" FontSize="13" TextWrapping="Wrap" LineHeight="20"
                   Margin="0,0,0,8" Visibility="Collapsed">
            You already have a full backup — choosing "Backup First" will replace it.
        </TextBlock>

        <!-- Buttons -->
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="Cancel"
                    Width="90" Height="32" Margin="0,0,8,0"
                    Background="#2D333B" Foreground="White"
                    BorderBrush="#444C56" BorderThickness="1"
                    Cursor="Hand"
                    Click="Cancel_Click"/>
            <Button Content="Restore"
                    Width="100" Height="32" Margin="0,0,8,0"
                    Background="#2D333B" Foreground="White"
                    BorderBrush="#444C56" BorderThickness="1"
                    Cursor="Hand"
                    Click="Restore_Click"/>
            <Button Content="💾  Backup First, Then Restore"
                    Width="210" Height="32"
                    Background="#1E90FF" Foreground="White"
                    BorderThickness="0"
                    FontWeight="SemiBold"
                    Cursor="Hand"
                    Click="BackupFirst_Click"/>
        </StackPanel>

    </StackPanel>
</Window>
