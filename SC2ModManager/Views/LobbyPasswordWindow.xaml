<Window x:Class="SC2ModManager.Views.LobbyPasswordWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Lobby Password"
        SizeToContent="WidthAndHeight"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="#0D1117">
    <StackPanel Margin="16">
        <TextBlock Text="This lobby is password-protected. Enter password:"
                   Foreground="#CCCCCC" TextWrapping="Wrap" MaxWidth="320" Margin="0,0,0,8"/>
        <PasswordBox x:Name="PasswordBox" Width="280" Height="28" Margin="0,0,0,12"/>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Cancel" Width="90" Margin="0,0,8,0" IsCancel="True" Click="Cancel_Click"/>
            <Button Content="OK" Width="90" IsDefault="True" Click="Ok_Click"/>
        </StackPanel>
    </StackPanel>
</Window>
