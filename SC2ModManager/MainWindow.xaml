<Window x:Class="SC2ModManager.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:SC2ModManager"
        Title="SC2 Mod Manager"
        Height="600"
        Width="1000"
        WindowStartupLocation="CenterScreen">

    <Window.Resources>
        <local:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter"/>
    </Window.Resources>

    <Grid>

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="220"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Grid.Background>
            <ImageBrush ImageSource="/Assets/uef.png"
                        Stretch="UniformToFill"/>
        </Grid.Background>

        <!-- SIDEBAR -->
        <StackPanel Grid.Column="0">
            <StackPanel.Background>
                <ImageBrush ImageSource="/Assets/spoiler_profile.png"
                            Stretch="UniformToFill"/>
            </StackPanel.Background>

            <TextBlock Text="SC2 Mod Manager"
                       Foreground="White"
                       FontSize="18"
                       Margin="10"/>

            <Button Content="Home" Click="GoHome" Margin="10"/>
            <Button Content="Manage Mods" Click="GoToMods" Margin="10"/>
        </StackPanel>

        <!-- MAIN CONTENT -->
        <Grid Grid.Column="1" Margin="10">

            <!-- HOME -->
            <StackPanel x:Name="HomeView">
                <TextBlock Text="Home" FontSize="22" Margin="0,0,0,20"/>

                <Button Content="Launch Game" Height="40" Click="LaunchGame_Click"/>

                <Button Content="Update Available"
                        Visibility="{Binding UpdateAvailable, Converter={StaticResource BoolToVisibilityConverter}}"
                        Height="40"
                        Margin="0,10,0,0"
                        Click="Update_Click"/>

                <ProgressBar Minimum="0" Maximum="100" Height="20"
                             Value="{Binding DownloadProgress}"
                             Visibility="{Binding UpdateAvailable, Converter={StaticResource BoolToVisibilityConverter}}"/>
            </StackPanel>

            <!-- MANAGE MODS MAIN -->
            <StackPanel x:Name="ModsView" Visibility="Collapsed">
                <TextBlock Text="Manage Mods" FontSize="22" Margin="0,0,0,20"/>

                <Button Content="Compare Current Mod State to Backup" Height="35"/>
                <Button Content="Current Mods Installed" Click="GoToInstalledMods" Height="35"/>
                <Button Content="Download Mods" Click="GoToDownloadMods" Height="35"/>
                <Button Content="Restore Original Game Files" Height="35" Click="RestoreOriginalGameData_Click"/>
                <Button Content="Back" Click="GoHome" Height="35"/>
            </StackPanel>

            <!-- INSTALLED MODS CATEGORY -->
            <StackPanel x:Name="InstalledModsView" Visibility="Collapsed">
                <TextBlock Text="Installed Mods" FontSize="22" Margin="0,0,0,20"/>

                <Button Content="Custom Maps" Click="GoToMaps" x:Name="InstalledCustomMaps"/>
                <Button Content="Hotkeys" x:Name="InstalledHotkeys"/>
                <Button Content="Balance Mods" x:Name="InstalledBalanceMods"/>
                <Button Content="Visual Mods" x:Name="InstalledVisualMods"/>
                <Button Content="Generic Gamedata Mods" x:Name="InstalledGamedataMods"/>

                <Button Content="Back" Click="GoToMods"/>
            </StackPanel>

            <!-- DOWNLOAD MODS CATEGORY -->
            <StackPanel x:Name="DownloadModsView" Visibility="Collapsed">
                <TextBlock Text="Download Mods" FontSize="22" Margin="0,0,0,20"/>

                <Button Content="Custom Maps" x:Name="DownloadCustomMaps"/>
                <Button Content="Hotkeys" x:Name="DownloadHotkeys"/>
                <Button Content="Balance Mods" x:Name="DownloadBalanceMods"/>
                <Button Content="Visual Mods" x:Name="DownloadVisualMods"/>
                <Button Content="Generic Gamedata Mods" x:Name="DownloadGamedataMods"/>

                <Button Content="Back" Click="GoToMods"/>
            </StackPanel>

            <!-- MAPS -->
            <StackPanel x:Name="MapsView" Visibility="Collapsed">
                <TextBlock Text="Custom Maps" FontSize="22" Margin="0,0,0,20"/>

                <ListBox ItemsSource="{Binding Maps}" AllowDrop="True" Drop="Maps_Drop" Height="250">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <CheckBox Content="{Binding FileName}" IsChecked="{Binding IsEnabled, Mode=TwoWay}"/>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                    <Button Content="Select All" Click="SelectAll"/>
                    <Button Content="Remove All" Click="RemoveAll"/>
                    <Button Content="Save" Click="SaveMaps"/>
                    <Button Content="Import Maps" Click="ImportMaps"/>
                </StackPanel>

                <Button Content="Back" Click="GoToInstalledMods" Margin="0,10,0,0"/>
            </StackPanel>

        </Grid>
    </Grid>
</Window>