<Window x:Class="SC2ModManager.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:SC2ModManager"
        Title="SC2 Mod Manager"
        Height="1000"
        Width="1800"
        WindowStartupLocation="CenterScreen"
        WindowState="Maximized"
        FontSize="14">

    <Window.Resources>
        <local:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter"/>
        <local:NullToVisibilityConverter        x:Key="NullToVisibilityConverter"/>
        <local:NullToInverseVisibilityConverter x:Key="NullToInverseVisibilityConverter"/>
        <local:StringToVisibilityConverter x:Key="StringToVisibilityConverter"/>
        <local:BoolToVisConverter x:Key="BoolToVisConverter"/>
        <local:InverseBoolToVisConverter x:Key="InverseBoolToVisConverter"/>
        <local:InverseBoolConverter x:Key="InverseBoolConverter"/>

        <!-- ===== COLORS ===== -->
        <!--<Color x:Key="AccentColor">#1E90FF</Color>
        <Color x:Key="AccentDarkColor">#1270CC</Color>
        <Color x:Key="ButtonBaseColor">#1A2535</Color>
        <Color x:Key="ButtonHoverColor">#1E3550</Color>
        <Color x:Key="ButtonPressedColor">#1270CC</Color>
        <Color x:Key="DisabledButtonColor">#2A2A2A</Color>

        <SolidColorBrush x:Key="AccentBrush"          Color="{StaticResource AccentColor}"/>
        <SolidColorBrush x:Key="AccentDarkBrush"      Color="{StaticResource AccentDarkColor}"/>
        <SolidColorBrush x:Key="ButtonBaseBrush"       Color="{StaticResource ButtonBaseColor}"/>
        <SolidColorBrush x:Key="ButtonHoverBrush"      Color="{StaticResource ButtonHoverColor}"/>
        <SolidColorBrush x:Key="ButtonPressedBrush"    Color="{StaticResource ButtonPressedColor}"/>
        <SolidColorBrush x:Key="DisabledButtonBrush"   Color="{StaticResource DisabledButtonColor}"/>
        <SolidColorBrush x:Key="PanelBackgroundBrush"  Color="#CC0D1117"/>
        <SolidColorBrush x:Key="SidebarOverlayBrush"   Color="#CC0A0F18"/>-->

        <!-- ===== BUTTON STYLE ===== -->
        <Style x:Key="ModernButton" TargetType="Button">
            <Setter Property="Foreground"        Value="White"/>
            <Setter Property="Background"  Value="{DynamicResource ButtonBaseBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
            <Setter Property="BorderThickness"   Value="1"/>
            <Setter Property="Padding"           Value="12,6"/>
            <Setter Property="FontSize"          Value="14"/>
            <Setter Property="FontFamily"        Value="Segoe UI"/>
            <Setter Property="Cursor"            Value="Hand"/>
            <Setter Property="Height"            Value="34"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="MinWidth" Value="80"/>
            <Setter Property="Width" Value="Auto"/>
            <Setter Property="Height" Value="36"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4"
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="{DynamicResource ButtonHoverBrush}"/>
                                <Setter TargetName="border" Property="BorderBrush"  Value="White"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="{DynamicResource ButtonPressedBrush}"/>
                                <Setter TargetName="border" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="border" Property="Background" Value="{DynamicResource DisabledButtonBrush}"/>
                                <Setter TargetName="border" Property="BorderBrush"  Value="#444"/>
                                <Setter Property="Foreground" Value="#666"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Accent-filled button for primary actions (Save, Download, Apply) -->
        <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource ModernButton}">
            <Setter Property="Background"  Value="{DynamicResource AccentBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource AccentDarkBrush}"/>
            <Setter Property="FontWeight"   Value="SemiBold"/>
            <Setter Property="MinWidth" Value="80"/>
            <Setter Property="Width" Value="Auto"/>
            <Setter Property="Height" Value="36"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4"
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="{DynamicResource AccentDarkBrush}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="{DynamicResource AccentDarkBrush}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="border" Property="Background" Value="{DynamicResource DisabledButtonBrush}"/>
                                <Setter TargetName="border" Property="BorderBrush"  Value="#444"/>
                                <Setter Property="Foreground" Value="#666"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Danger button for destructive actions (Delete) -->
        <Style x:Key="DangerButton" TargetType="Button" BasedOn="{StaticResource ModernButton}">
            <Setter Property="BorderBrush" Value="#CC2200"/>
            <Setter Property="MinWidth" Value="80"/>
            <Setter Property="Width" Value="Auto"/>
            <Setter Property="Height" Value="36"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4"
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background"  Value="#3D0A00"/>
                                <Setter TargetName="border" Property="BorderBrush" Value="#FF4422"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background"  Value="#CC2200"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="border" Property="Background" Value="{DynamicResource DisabledButtonBrush}"/>
                                <Setter TargetName="border" Property="BorderBrush"  Value="#444"/>
                                <Setter Property="Foreground" Value="#666"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Sidebar button style -->
        <Style x:Key="SidebarButton" TargetType="Button" BasedOn="{StaticResource ModernButton}">
            <Setter Property="Margin"         Value="10,4"/>
            <Setter Property="Height"         Value="36"/>
            <Setter Property="FontSize"       Value="14"/>
            <Setter Property="Background"     Value="#22FFFFFF"/>
            <Setter Property="BorderBrush"    Value="#44FFFFFF"/>
            <Setter Property="MinWidth" Value="80"/>
            <Setter Property="Width" Value="Auto"/>
            <Setter Property="Height" Value="36"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="{DynamicResource AccentBrush}"/>
                                <Setter TargetName="border" Property="BorderBrush" Value="{DynamicResource AccentDarkBrush}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="{DynamicResource AccentDarkBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Global default button override -->
        <Style TargetType="Button" BasedOn="{StaticResource ModernButton}"/>

        <!-- ListBox style -->
        <Style TargetType="ListBox">
            <Setter Property="Background"        Value="#CC0D1117"/>
            <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
            <Setter Property="BorderThickness"   Value="1"/>
            <Setter Property="Foreground"        Value="White"/>
            <Setter Property="Padding"           Value="4"/>
        </Style>

        <Style TargetType="ListBoxItem">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Padding"    Value="4,3"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="itemBorder"
                                Background="Transparent"
                                BorderThickness="0"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="itemBorder" Property="Background" Value="{DynamicResource ListBoxSelectionBrush}"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="itemBorder" Property="Background" Value="{DynamicResource ListBoxHoverBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- CheckBox style -->
        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontSize"   Value="13"/>
        </Style>

        <!-- TextBlock style -->
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
        </Style>

        <!-- TextBox style -->
        <Style TargetType="TextBox">
            <Setter Property="Background" Value="{DynamicResource ButtonBaseBrush}"/>
            <Setter Property="Foreground"      Value="White"/>
            <Setter Property="BorderBrush"     Value="{DynamicResource AccentBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding"         Value="6,4"/>
            <Setter Property="FontFamily"      Value="Segoe UI"/>
            <Setter Property="FontSize"        Value="14"/>
            <Setter Property="CaretBrush"      Value="White"/>
        </Style>

        <!-- ComboBox style -->
        <Style TargetType="ComboBox">
            <Setter Property="Background" Value="{DynamicResource ButtonBaseBrush}"/>
            <Setter Property="Foreground"      Value="White"/>
            <Setter Property="BorderBrush"     Value="{DynamicResource AccentBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding"         Value="6,4"/>
            <Setter Property="FontFamily"      Value="Segoe UI"/>
            <Setter Property="FontSize"        Value="14"/>
            <Setter Property="Height"          Value="30"/>
            <Style.Resources>
                <Style TargetType="TextBlock">
                    <Setter Property="Foreground" Value="White"/>
                </Style>
            </Style.Resources>
        </Style>

        <!-- ProgressBar style -->
        <Style TargetType="ProgressBar">
            <Setter Property="Background" Value="{DynamicResource ButtonBaseBrush}"/>
            <Setter Property="Foreground"  Value="{DynamicResource AccentBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
            <Setter Property="Height"      Value="14"/>
        </Style>

        <!-- Section header text -->
        <Style x:Key="SectionHeader" TargetType="TextBlock">
            <Setter Property="Foreground"  Value="White"/>
            <Setter Property="FontSize"    Value="24"/>
            <Setter Property="FontFamily"  Value="Segoe UI"/>
            <Setter Property="FontWeight"  Value="Light"/>
            <Setter Property="Margin"      Value="0,0,0,16"/>
        </Style>

        <!-- Panel card background -->
        <Style x:Key="ContentPanel" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource PanelBackgroundBrush}"/>
            <Setter Property="BorderBrush"     Value="#33FFFFFF"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius"    Value="6"/>
            <Setter Property="Padding"         Value="16"/>
        </Style>

        <!-- Column header -->
        <Style x:Key="ColumnHeader" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/>
            <Setter Property="FontSize"     Value="15"/>
            <Setter Property="FontWeight"   Value="SemiBold"/>
            <Setter Property="FontFamily"   Value="Segoe UI"/>
            <Setter Property="FontSize"     Value="14"/>
            <Setter Property="Margin"       Value="0,0,0,6"/>
        </Style>

        <!-- Separator line -->
        <Style x:Key="HRule" TargetType="Separator">
            <Setter Property="Background"       Value="#33FFFFFF"/>
            <Setter Property="Margin"           Value="0,8"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
        </Style>
        
        <!-- RadioButton style -->
        <Style TargetType="RadioButton">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontSize"   Value="13"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

        <!-- DataGrid styles -->
        <Style TargetType="DataGrid">
            <Setter Property="HorizontalGridLinesBrush" Value="#22FFFFFF"/>
            <Setter Property="VerticalGridLinesBrush"   Value="Transparent"/>
        </Style>

        <Style TargetType="DataGridRow">
            <Setter Property="Foreground" Value="White"/>
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="{DynamicResource ListBoxSelectionBrush}"/>
                </Trigger>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{DynamicResource ListBoxHoverBrush}"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style TargetType="DataGridCell">
            <Setter Property="Foreground"      Value="White"/>
            <Setter Property="BorderBrush"     Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background"  Value="Transparent"/>
                    <Setter Property="BorderBrush" Value="Transparent"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style TargetType="DataGridColumnHeader">
            <Setter Property="Background"                 Value="{DynamicResource ButtonBaseBrush}"/>
            <Setter Property="Foreground"                 Value="{DynamicResource AccentBrush}"/>
            <Setter Property="FontWeight"                 Value="SemiBold"/>
            <Setter Property="FontFamily"                 Value="Segoe UI"/>
            <Setter Property="FontSize"                   Value="13"/>
            <Setter Property="Padding"                    Value="8,4"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="BorderBrush"                Value="#33FFFFFF"/>
            <Setter Property="BorderThickness"            Value="0,0,0,1"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="DataGridColumnHeader">
                        <Grid>
                            <Border x:Name="headerBorder"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    Padding="{TemplateBinding Padding}">
                                <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                  VerticalAlignment="Center"/>
                            </Border>
                            <Thumb x:Name="PART_LeftHeaderGripper" HorizontalAlignment="Left" Width="8" Cursor="SizeWE">
                                <Thumb.Style>
                                    <Style TargetType="Thumb">
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="Thumb">
                                                    <Border Background="Transparent"/>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                </Thumb.Style>
                            </Thumb>
                            <Thumb x:Name="PART_RightHeaderGripper" HorizontalAlignment="Right" Width="8" Cursor="SizeWE">
                                <Thumb.Style>
                                    <Style TargetType="Thumb">
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="Thumb">
                                                    <Border Background="Transparent"/>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                </Thumb.Style>
                            </Thumb>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="headerBorder" Property="Background" Value="{DynamicResource ButtonHoverBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- TabControl / TabItem styles -->
        <Style TargetType="TabControl">
            <Setter Property="Background"      Value="Transparent"/>
            <Setter Property="BorderBrush"     Value="#33FFFFFF"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding"         Value="6"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabControl">
                        <Grid KeyboardNavigation.TabNavigation="Local">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <TabPanel Grid.Row="0" IsItemsHost="True"
                                      Background="Transparent" Margin="0,0,0,-1"/>
                            <Border Grid.Row="1"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="0,4,4,4"
                                    Padding="{TemplateBinding Padding}">
                                <ContentPresenter x:Name="PART_SelectedContentHost"
                                                  ContentSource="SelectedContent"/>
                            </Border>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="TabItem">
            <Setter Property="Foreground"  Value="#AAAAAA"/>
            <Setter Property="Background"  Value="{DynamicResource ButtonBaseBrush}"/>
            <Setter Property="BorderBrush" Value="#33FFFFFF"/>
            <Setter Property="FontFamily"  Value="Segoe UI"/>
            <Setter Property="FontSize"    Value="13"/>
            <Setter Property="Padding"     Value="12,6"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border x:Name="tabBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="1,1,1,0"
                                CornerRadius="4,4,0,0"
                                Margin="0,0,2,0"
                                Padding="{TemplateBinding Padding}"
                                SnapsToDevicePixels="True">
                            <ContentPresenter ContentSource="Header"
                                              HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              TextBlock.Foreground="{TemplateBinding Foreground}"
                                              TextBlock.FontFamily="{TemplateBinding FontFamily}"
                                              TextBlock.FontSize="{TemplateBinding FontSize}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="tabBorder" Property="Background"  Value="{DynamicResource AccentBrush}"/>
                                <Setter TargetName="tabBorder" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="tabBorder" Property="Background" Value="{DynamicResource ButtonHoverBrush}"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="220"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Grid.Background>
            <ImageBrush x:Name="MainBackgroundBrush" ImageSource="{DynamicResource ThemeMainBgImage}" Stretch="UniformToFill"/>
        </Grid.Background>

        <!-- ===== SIDEBAR ===== -->
        <Border Grid.Column="0">
            <Border.Background>
                <ImageBrush x:Name="SidebarBackgroundBrush" ImageSource="{DynamicResource ThemeSidebarImage}" Stretch="UniformToFill"/>
            </Border.Background>

            <!-- Dark overlay so text is readable -->
            <Grid>
                <Rectangle Fill="{DynamicResource SidebarOverlayBrush}"/>

                <StackPanel Margin="0,16,0,0">

                    <!-- Logo / Title block -->
                    <StackPanel Margin="14,0,14,16">
                        <TextBlock Text="Supreme Commander 2"
                                   Foreground="White"
                                   FontSize="17"
                                   FontWeight="Bold"
                                   FontFamily="Segoe UI"
                                   TextWrapping="Wrap"/>
                        <TextBlock Text="Mod Manager"
                                   Foreground="{DynamicResource AccentBrush}"
                                   FontSize="19"
                                   FontWeight="Light"
                                   FontFamily="Segoe UI"/>

                        <Separator Style="{StaticResource HRule}" Margin="0,8"/>

                        <TextBlock Text="by OSS | | Jaywix"
                                   Foreground="#AAAAAA"
                                   FontSize="13"
                                   FontFamily="Segoe UI"/>

                        <TextBlock x:Name="VersionText"
                                   Foreground="#666666"
                                   FontSize="12"
                                   FontFamily="Segoe UI"
                                   Margin="0,2,0,0"/>
                    </StackPanel>

                    <Separator Style="{StaticResource HRule}" Margin="14,0"/>

                    <Button Content="🏠  Home"        Style="{StaticResource SidebarButton}" Click="GoHome"/>
                    <Button Content="⚙  Manage Mods" Style="{StaticResource SidebarButton}" Click="GoToMods"/>
                    <Button Content="🎬  Replays"     Style="{StaticResource SidebarButton}" Click="GoToReplays"/>
                    <Button Content="⚙  Settings" Style="{StaticResource SidebarButton}" Click="GoToSettings"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ===== MAIN CONTENT ===== -->
        <Border Grid.Column="1" Background="{DynamicResource SidebarOverlayBrush}">
            <Grid Margin="20,16,20,16">


                <!-- ===== HOME ===== -->
                <Grid x:Name="HomeView">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>  <!-- header -->
                        <RowDefinition Height="Auto"/>  <!-- launch -->
                        <RowDefinition Height="Auto"/>  <!-- update -->
                        <RowDefinition Height="Auto"/>  <!-- unrecognized mods stuff -->
                        <RowDefinition Height="Auto"/>  <!-- how-to -->
                        <RowDefinition Height="*"/>     <!-- news -->
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="Home" Style="{StaticResource SectionHeader}"/>

                    <!-- Launch -->
                    <Border Grid.Row="1" Style="{StaticResource ContentPanel}" Margin="0,0,0,12">
                        <StackPanel>
                            <TextBlock Text="Game" Foreground="{DynamicResource AccentBrush}"
                       FontWeight="SemiBold" FontSize="14" Margin="0,0,0,8"/>
                            <Button Content="▶  Launch Game" Style="{StaticResource PrimaryButton}"
                    Height="40" Click="LaunchGame_Click"/>
                        </StackPanel>
                    </Border>

                    <!-- Update (only shown if available) -->
                    <Border Grid.Row="2" Style="{StaticResource ContentPanel}" Margin="0,0,0,12"
            Visibility="{Binding UpdateAvailable, Converter={StaticResource BoolToVisibilityConverter}}">
                        <StackPanel>
                            <TextBlock Text="Update Available" Foreground="{DynamicResource AccentBrush}"
                       FontWeight="SemiBold" FontSize="14" Margin="0,0,0,8"/>
                            <Button Content="⬇  Download Update" Height="38" Click="Update_Click"/>
                            <ProgressBar Margin="0,8,0,0" Value="{Binding DownloadProgress}"/>
                        </StackPanel>
                    </Border>

                    <!-- Unrecognized files banner -->
                    <Border Grid.Row="3" Background="#1A1000" BorderBrush="#AA6600"
        BorderThickness="1" CornerRadius="4" Padding="12,10" Margin="0,0,0,12"
        Visibility="{Binding HasUnrecognizedFiles, Converter={StaticResource BoolToVisibilityConverter}}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="⚠  Unrecognized files detected in gamedata"
                       Foreground="#FFAA00" FontWeight="SemiBold" FontSize="14" Margin="0,0,0,4"/>
                                <TextBlock Foreground="#CCCCCC" FontSize="13" TextWrapping="Wrap"
                       Text="Files were found in your gamedata folder that aren't original game files. Click Review to manage them."/>
                            </StackPanel>
                            <Button Grid.Column="1" Content="Review →" Style="{StaticResource PrimaryButton}"
                Width="90" Margin="12,0,0,0" Click="GoToScanGamedata"/>
                        </Grid>
                    </Border>

                    <!-- How-to section -->
                    <Border Grid.Row="4" Style="{StaticResource ContentPanel}" Margin="0,0,0,12">
                        <StackPanel>
                            <Button x:Name="HowToToggleButton"
                Content="▼  How to Use"
                HorizontalAlignment="Left"
                Click="HowToToggle_Click"/>

                            <StackPanel x:Name="HowToPanel" Visibility="Collapsed" Margin="0,14,0,0">

                                <TextBlock Text="📥  Downloading Mods"
                       Foreground="{DynamicResource AccentBrush}"
                       FontWeight="SemiBold" FontSize="14" Margin="0,0,0,6"/>
                                <TextBlock TextWrapping="Wrap" Foreground="#CCCCCC" FontSize="13" LineHeight="18" Margin="0,0,0,12">
                Go to <Run FontWeight="Bold">Manage Mods → Download</Run> and choose a mod type (Maps or Generic Gamedata Mods).
                Check the boxes next to the mods you want and click <Run FontWeight="Bold">Download</Run>.
                Downloaded mods are stored by the mod manager and start out disabled.
                                </TextBlock>

                                <TextBlock Text="✅  Enabling and Disabling Mods"
                       Foreground="{DynamicResource AccentBrush}"
                       FontWeight="SemiBold" FontSize="14" Margin="0,0,0,6"/>
                                <TextBlock TextWrapping="Wrap" Foreground="#CCCCCC" FontSize="13" LineHeight="18" Margin="0,0,0,12">
                Go to <Run FontWeight="Bold">Manage Mods → Installed</Run> and choose a mod type.
                Check the boxes next to the mods you want to enable or disable, then click the corresponding button.
                When you're done, click <Run FontWeight="Bold">Save</Run> to apply the changes to your game.
                Mods that are enabled are copied into your gamedata folder. Disabled mods are stored safely by the mod manager.
                                </TextBlock>

                                <TextBlock Text="💾  Using Presets"
                       Foreground="{DynamicResource AccentBrush}"
                       FontWeight="SemiBold" FontSize="14" Margin="0,0,0,6"/>
                                <TextBlock TextWrapping="Wrap" Foreground="#CCCCCC" FontSize="13" LineHeight="18" Margin="0,0,0,12">
                Presets let you save and restore your current mod setup instantly.
                Go to <Run FontWeight="Bold">Manage Mods → Backups → Presets</Run>, enter a name, and click <Run FontWeight="Bold">Save</Run>.
                To restore a setup, select a preset and click <Run FontWeight="Bold">Apply</Run>.
                                </TextBlock>

                                <TextBlock Text="🔄  Restoring Original Game Files"
                       Foreground="{DynamicResource AccentBrush}"
                       FontWeight="SemiBold" FontSize="14" Margin="0,0,0,6"/>
                                <TextBlock TextWrapping="Wrap" Foreground="#CCCCCC" FontSize="13" LineHeight="18" Margin="0,0,0,12">
                If something goes wrong with your game files, go to <Run FontWeight="Bold">Manage Mods → Backups → Restore Original Game Files</Run>.
                This will download the original unmodified gamedata from GitHub and replace your current gamedata folder.
                Your installed mods will not be deleted — they are stored separately by the mod manager.
                                </TextBlock>

                                <TextBlock Text="🔍  Scanning for Unrecognized Files"
                       Foreground="{DynamicResource AccentBrush}"
                       FontWeight="SemiBold" FontSize="14" Margin="0,0,0,6"/>
                                <TextBlock TextWrapping="Wrap" Foreground="#CCCCCC" FontSize="13" LineHeight="18">
                If you added mod files directly to your gamedata folder without using the mod manager,
                go to <Run FontWeight="Bold">Manage Mods → Installed → Scan Gamedata for Unrecognized Mods</Run>.
                You can then import those files so the mod manager tracks them, or delete them if you don't want them.
                                </TextBlock>

                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- News feed -->
                    <Border Grid.Row="5" Style="{StaticResource ContentPanel}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Text="News &amp; Announcements"
                       Foreground="{DynamicResource AccentBrush}"
                       FontWeight="SemiBold" FontSize="14" Margin="0,0,0,12"/>

                            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                                <ItemsControl ItemsSource="{Binding NewsItems}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Margin="0,0,0,12" CornerRadius="6" Padding="16">
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Setter Property="Background" Value="#CC0D1117"/>
                                                        <Setter Property="BorderThickness" Value="1"/>
                                                        <Setter Property="BorderBrush" Value="#33FFFFFF"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Type}" Value="tournament">
                                                                <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                                                                <Setter Property="Background" Value="{DynamicResource ListBoxSelectionBrush}"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding Type}" Value="update">
                                                                <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                                                                <Setter Property="Background" Value="{DynamicResource ListBoxSelectionBrush}"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding Type}" Value="discord">
                                                                <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                                                                <Setter Property="Background" Value="{DynamicResource ListBoxSelectionBrush}"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>

                                                <StackPanel>
                                                    <!-- Header row — always visible, contains toggle -->
                                                    <Grid Margin="0,0,0,8">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="Auto"/>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                        </Grid.ColumnDefinitions>

                                                        <Border Grid.Column="0" CornerRadius="3" Padding="6,2" Margin="0,0,8,0">
                                                            <Border.Style>
                                                                <Style TargetType="Border">
                                                                    <Setter Property="Background" Value="#33FFFFFF"/>
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding Type}" Value="tournament">
                                                                            <Setter Property="Background" Value="{DynamicResource ListBoxSelectionBrush}"/>
                                                                        </DataTrigger>
                                                                        <DataTrigger Binding="{Binding Type}" Value="update">
                                                                            <Setter Property="Background" Value="{DynamicResource ListBoxSelectionBrush}"/>
                                                                        </DataTrigger>
                                                                        <DataTrigger Binding="{Binding Type}" Value="discord">
                                                                            <Setter Property="Background" Value="{DynamicResource ListBoxSelectionBrush}"/>
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </Border.Style>
                                                            <TextBlock FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center">
                                                                <TextBlock.Style>
                                                                    <Style TargetType="TextBlock">
                                                                        <Setter Property="Text" Value="GENERAL"/>
                                                                        <Setter Property="Foreground" Value="#AAAAAA"/>
                                                                        <Style.Triggers>
                                                                            <DataTrigger Binding="{Binding Type}" Value="tournament">
                                                                                <Setter Property="Text" Value="🏆 TOURNAMENT"/>
                                                                                <Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/>
                                                                            </DataTrigger>
                                                                            <DataTrigger Binding="{Binding Type}" Value="update">
                                                                                <Setter Property="Text" Value="⬆ UPDATE"/>
                                                                                <Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/>
                                                                            </DataTrigger>
                                                                            <DataTrigger Binding="{Binding Type}" Value="discord">
                                                                                <Setter Property="Text" Value="💬 DISCORD"/>
                                                                                <Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/>
                                                                            </DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </TextBlock.Style>
                                                            </TextBlock>
                                                        </Border>

                                                        <TextBlock Grid.Column="1" Text="{Binding Title}"
                               FontSize="16" FontWeight="SemiBold"
                               Foreground="White" VerticalAlignment="Center"
                               TextWrapping="Wrap"/>

                                                        <TextBlock Grid.Column="2" Text="{Binding Date}"
                               FontSize="12" Foreground="#666666"
                               VerticalAlignment="Center" Margin="12,0,8,0"/>

                                                        <Button Grid.Column="3" Content="{Binding ToggleIcon}"
                            Click="NewsItemToggle_Click"
                            Width="28" Height="24" FontSize="12"
                            Padding="0" VerticalAlignment="Center"/>
                                                    </Grid>

                                                    <!-- Body — collapsible -->
                                                    <StackPanel Visibility="{Binding IsExpanded, Converter={StaticResource BoolToVisibilityConverter}}">
                                                        <Border CornerRadius="4" Margin="0,0,0,10" MaxHeight="600">
                                                            <Image Source="{Binding ImageUrl}" Stretch="Uniform" VerticalAlignment="Center"/>
                                                        </Border>

                                                        <TextBlock Text="{Binding Body}" FontSize="14" Foreground="#CCCCCC"
                               TextWrapping="Wrap" LineHeight="20" Margin="0,0,0,10"/>

                                                        <ItemsControl ItemsSource="{Binding Links}"
              Visibility="{Binding HasLinks, Converter={StaticResource BoolToVisibilityConverter}}">
                                                            <ItemsControl.ItemsPanel>
                                                                <ItemsPanelTemplate>
                                                                    <WrapPanel/>
                                                                </ItemsPanelTemplate>
                                                            </ItemsControl.ItemsPanel>
                                                            <ItemsControl.ItemTemplate>
                                                                <DataTemplate>
                                                                    <Button Content="{Binding Text}"
                    Tag="{Binding Url}"
                    Click="NewsLink_Click"
                    Margin="0,0,6,4">
                                                                        <Button.Style>
                                                                            <Style TargetType="Button" BasedOn="{StaticResource ModernButton}">
                                                                                <Setter Property="Height"   Value="30"/>
                                                                                <Setter Property="FontSize" Value="12"/>
                                                                                <Setter Property="Padding"  Value="12,4"/>
                                                                            </Style>
                                                                        </Button.Style>
                                                                    </Button>
                                                                </DataTemplate>
                                                            </ItemsControl.ItemTemplate>
                                                        </ItemsControl>
                                                    </StackPanel>
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </Grid>
                    </Border>
                </Grid>

                <!-- ===== SETTINGS ===== -->
                <StackPanel x:Name="SettingsView" Visibility="Collapsed">
                    <TextBlock Text="Settings" Style="{StaticResource SectionHeader}"/>
                    <Border Style="{StaticResource ContentPanel}">
                        <StackPanel>
                            <TextBlock Text="Game Path"
                       Foreground="{DynamicResource AccentBrush}"
                       FontWeight="SemiBold" FontSize="14" Margin="0,0,0,6"/>
                            <TextBlock Text="Current path:" Foreground="#AAAAAA" FontSize="12" Margin="0,0,0,4"/>
                            <TextBlock Text="{Binding GamePath}" Foreground="White"
                       FontSize="13" TextWrapping="Wrap" Margin="0,0,0,12"/>
                            <Separator Style="{StaticResource HRule}" Margin="0,16,8,0"/>
                            <TextBlock Text="Theme" Foreground="{DynamicResource AccentBrush}"
           FontWeight="SemiBold" FontSize="14" Margin="0,0,0,8"/>
                            <TextBlock Text="Choose your faction theme. Changes apply immediately."
           Foreground="#AAAAAA" FontSize="12" Margin="0,0,0,12" TextWrapping="Wrap"/>

                            <WrapPanel>
                                <!-- Standard -->
                                <Border x:Name="ThemeStandardBtn" Margin="0,0,8,8" CornerRadius="6" Padding="12,8"
            Background="#1A2535" BorderThickness="2" BorderBrush="#1E90FF"
            Cursor="Hand" MouseLeftButtonUp="ThemeStandard_Click_Border">
                                    <StackPanel>
                                        <TextBlock Text="⚡  Jaywix Standard" Foreground="White"
                       FontSize="13" FontWeight="SemiBold" Margin="0,0,0,4"/>
                                        <Border Height="5" CornerRadius="2" Background="#1E90FF"/>
                                    </StackPanel>
                                </Border>

                                <!-- UEF -->
                                <Border x:Name="ThemeUEFBtn" Margin="0,0,8,8" CornerRadius="6" Padding="12,8"
            Background="#1A2535" BorderThickness="2" BorderBrush="#444444"
            Cursor="Hand" MouseLeftButtonUp="ThemeUEF_Click_Border">
                                    <StackPanel>
                                        <TextBlock Text="UEF" Foreground="White"
                       FontSize="13" FontWeight="SemiBold" Margin="0,0,0,4"/>
                                        <Border Height="5" CornerRadius="2" Background="#1E90FF"/>
                                    </StackPanel>
                                </Border>

                                <!-- Cybran -->
                                <Border x:Name="ThemeCybranBtn" Margin="0,0,8,8" CornerRadius="6" Padding="12,8"
            Background="#1F0A08" BorderThickness="2" BorderBrush="#444444"
            Cursor="Hand" MouseLeftButtonUp="ThemeCybran_Click_Border">
                                    <StackPanel>
                                        <TextBlock Text="Cybran" Foreground="White"
                       FontSize="13" FontWeight="SemiBold" Margin="0,0,0,4"/>
                                        <Border Height="5" CornerRadius="2" Background="#CC2200"/>
                                    </StackPanel>
                                </Border>

                                <!-- Aeon -->
                                <Border x:Name="ThemeAeonBtn" Margin="0,0,8,8" CornerRadius="6" Padding="12,8"
            Background="#0A1A18" BorderThickness="2" BorderBrush="#444444"
            Cursor="Hand" MouseLeftButtonUp="ThemeAeon_Click_Border">
                                    <StackPanel>
                                        <TextBlock Text="Aeon Illuminate" Foreground="White"
                       FontSize="13" FontWeight="SemiBold" Margin="0,0,0,4"/>
                                        <Border Height="5" CornerRadius="2" Background="#00BFA5"/>
                                    </StackPanel>
                                </Border>
                            </WrapPanel>
                            <Separator Style="{StaticResource HRule}"/>
                            <TextBlock Text="Change Game Path" Foreground="#AAAAAA"
                       FontSize="12" Margin="0,0,0,6"/>
                            <StackPanel Orientation="Horizontal">
                                <TextBox x:Name="GamePathInput"
                         Width="320" Margin="0,0,8,0"
                         VerticalContentAlignment="Center"
                         />
                                <Button Content="📁  Browse" Width="100" Margin="0,0,6,0"
                        Click="BrowseGamePath_Click"/>
                                <Button Content="✅  Set Path" Style="{StaticResource PrimaryButton}"
                         Click="SetGamePath_Click"/>
                            </StackPanel>
                            <Separator Style="{StaticResource HRule}" Margin="0,16,8,0"/>
                            <TextBlock Text="Uninstall" Foreground="{DynamicResource AccentBrush}"
                               FontWeight="SemiBold" FontSize="14" Margin="0,0,0,6"/>
                                                <TextBlock Text="Permanently removes all SC2 Mod Manager files and data."
                               Foreground="#AAAAAA" FontSize="12" Margin="0,0,0,10" TextWrapping="Wrap"/>
                                                <Button Content="🗑  Uninstall SC2 Mod Manager"
                            Style="{StaticResource DangerButton}"
                             HorizontalAlignment="Left"
                            Click="Uninstall_Click"/>
                            <Separator Style="{StaticResource HRule}" Margin="0,16,8,0"/>
                            <TextBlock Text="Previous Versions"
                               Foreground="{DynamicResource AccentBrush}"
                               FontWeight="SemiBold" FontSize="14" Margin="0,0,0,6"/>
                            <TextBlock Text="Roll back to an earlier version of SC2 Mod Manager if you are experiencing issues. Versions as far back as v1.6.0 are available."
                               Foreground="#AAAAAA" FontSize="12" Margin="0,0,0,10" TextWrapping="Wrap"/>
                            <Button Content="🕐  See Previous Versions"
                                    HorizontalAlignment="Left"
                                    Click="SeePreviousVersions_Click"/>
                            <Separator Style="{StaticResource HRule}" Margin="0,16,8,0"/>
                            <TextBlock Text="File Locations"
           Foreground="{DynamicResource AccentBrush}"
           FontWeight="SemiBold" FontSize="13" Margin="0,0,0,6"/>
                            <TextBlock Text="Quickly open common Supreme Commander 2 file locations."
           Foreground="#AAAAAA" FontSize="12" Margin="0,0,0,10" TextWrapping="Wrap"/>
                            <Button Content="📁  Open File Locations"
        HorizontalAlignment="Left"
        Click="GoToFileLocations"/>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- ===== REPLAYS ===== -->
                <Grid x:Name="ReplayView" Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Header -->
                    <DockPanel Grid.Row="0" Margin="0,0,0,16">
                        <Button DockPanel.Dock="Left" Content="← Back"
                                Click="GoHome"
                                HorizontalAlignment="Left" Width="80" Margin="0,0,12,0"
                                VerticalAlignment="Center"/>
                        <TextBlock Text="Replays"
                                   Foreground="White" FontSize="24" FontFamily="Segoe UI"
                                   FontWeight="Light" VerticalAlignment="Center"/>
                    </DockPanel>

                    <!-- Not Installed panel -->
                    <Border Grid.Row="1" Style="{StaticResource ContentPanel}"
                            x:Name="ReplayNotInstalledPanel">
                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Width="460">
                            <TextBlock Text="🎬  Replay Launcher Not Set Up"
                                       FontSize="18" FontWeight="SemiBold" Foreground="White"
                                       HorizontalAlignment="Center" Margin="0,0,0,12"/>
                            <TextBlock TextWrapping="Wrap" Foreground="#CCCCCC" FontSize="13"
                                       HorizontalAlignment="Center" TextAlignment="Center" Margin="0,0,0,16">
                                To launch replays, the mod manager needs to download two small replay
                                support files. These files are stored in the mod manager's data folder
                                and never interfere with your game.
                            </TextBlock>
                            <Button x:Name="DownloadReplayToolsBtn"
                                    Content="⬇  Download Replay Tools"
                                    Style="{StaticResource PrimaryButton}"
                                    HorizontalAlignment="Center" Width="240"
                                    Click="DownloadReplayTools_Click"/>
                            <TextBlock x:Name="ReplayDownloadStatusText"
                                       Text="Downloading..."
                                       Foreground="{DynamicResource AccentBrush}" FontSize="14"
                                       HorizontalAlignment="Center" Margin="0,10,0,0"
                                       Visibility="Collapsed"/>
                        </StackPanel>
                    </Border>

                    <!-- Installed content -->
                    <Grid Grid.Row="1" x:Name="ReplayInstalledPanel" Visibility="Collapsed">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <!-- Folder path row -->
                        <Border Grid.Row="0" Style="{StaticResource ContentPanel}" Margin="0,0,0,10">
                            <DockPanel>
                                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                                    <Button Content="📁  Browse" Margin="0,0,6,0" Click="BrowseReplayFolder_Click"/>
                                    <Button Content="🔄  Refresh" Click="RefreshReplays_Click"/>
                                </StackPanel>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="Replays Folder"
                                               Foreground="{DynamicResource AccentBrush}"
                                               FontWeight="SemiBold" FontSize="13" Margin="0,0,0,4"/>
                                    <TextBlock x:Name="ReplayFolderPathText"
                                               Foreground="#CCCCCC" FontSize="12" TextWrapping="Wrap"/>
                                </StackPanel>
                            </DockPanel>
                        </Border>

                        <!-- Game running banner -->
                        <Border Grid.Row="1" Background="#0D1A2A" BorderBrush="{DynamicResource AccentBrush}"
                                BorderThickness="1" CornerRadius="4" Padding="14,10" Margin="0,0,0,10"
                                x:Name="ReplayRunningBanner" Visibility="Collapsed">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="▶" Foreground="{DynamicResource AccentBrush}" FontSize="16"
                                           VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <TextBlock Foreground="White" FontSize="13" VerticalAlignment="Center"
                                           TextWrapping="Wrap">
                                    <Run Text="Replay is running. "/>
                                    <Run FontWeight="SemiBold"
                                         Text="Close the game when you're done"/>
                                    <Run Text=" — your game files will be restored automatically."/>
                                </TextBlock>
                            </StackPanel>
                        </Border>

                        <!-- Replay list -->
                        <Grid Grid.Row="2">
                            <TextBlock x:Name="ReplayFolderMissingText"
                                       Foreground="#AAAAAA" FontSize="13"
                                       HorizontalAlignment="Center" VerticalAlignment="Top"
                                       Margin="0,20,0,0" TextWrapping="Wrap" TextAlignment="Center"
                                       Visibility="Collapsed">
                                Replays folder not found. Click <Run Foreground="{DynamicResource AccentBrush}">📁 Browse</Run> to locate your replays folder.
                            </TextBlock>
                            <TextBlock x:Name="ReplayEmptyText"
                                       Text="No replays found in the selected folder."
                                       Foreground="#666666" FontSize="13"
                                       HorizontalAlignment="Center" VerticalAlignment="Top"
                                       Margin="0,20,0,0"
                                       Visibility="Collapsed"/>
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <StackPanel x:Name="ReplayListPanel" Margin="0,0,4,0"/>
                            </ScrollViewer>
                        </Grid>
                    </Grid>
                </Grid>

                <!-- ===== PREVIOUS VERSIONS ===== -->
                <Grid x:Name="PreviousVersionsView" Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Header with back button -->
                    <Grid Grid.Row="0" Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Button Grid.Column="0" Content="← Back to Settings"
                                Margin="0,0,12,0"
                                Click="GoToSettings"/>
                        <TextBlock Grid.Column="1" Text="Previous Versions"
                                   Style="{StaticResource SectionHeader}"
                                   Margin="0"/>
                    </Grid>

                    <!-- Warning banner -->
                    <Border Grid.Row="1" Background="#1C1600" BorderBrush="#856404"
                            BorderThickness="1" CornerRadius="4" Padding="14,10" Margin="0,0,0,12">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="⚠" Foreground="#E3B341" FontSize="16"
                                       VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <TextBlock Foreground="#E3B341" FontSize="12"
                                       VerticalAlignment="Center" TextWrapping="Wrap">
                                <Run Text="Rolling back to an older version may cause some mods to stop working and can cause issues with newer features. Only versions v1.6.0 and newer are available."/>
                            </TextBlock>
                        </StackPanel>
                    </Border>

                    <!-- Version list -->
                    <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
                        <StackPanel x:Name="PreviousVersionsListPanel" Margin="0,0,4,0">
                            <TextBlock x:Name="PreviousVersionsLoadingText"
                                       Text="Loading versions..."
                                       Foreground="#8B949E" FontSize="13" Margin="0,8"/>
                            <TextBlock x:Name="PreviousVersionsErrorText"
                                       Foreground="#F85149" FontSize="13"
                                       Visibility="Collapsed" TextWrapping="Wrap" Margin="0,8"/>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>

                <!-- ===== FILE LOCATIONS ===== -->
                <Grid x:Name="FileLocationsView" Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="Common File Locations" Style="{StaticResource SectionHeader}"/>

                    <!-- Replays -->
                    <Border Grid.Row="1" Style="{StaticResource ContentPanel}" Margin="0,0,0,10">
                        <StackPanel>
                            <TextBlock Text="🎬  Replays Folder"
                       Foreground="{DynamicResource AccentBrush}"
                       FontWeight="SemiBold" FontSize="13" Margin="0,0,0,8"/>

                            <!-- Found -->
                            <StackPanel Visibility="{Binding ReplaysFound, Converter={StaticResource BoolToVisibilityConverter}}">
                                <TextBlock Text="{Binding ReplaysPath}" Foreground="#CCCCCC"
                           FontSize="12" TextWrapping="Wrap" Margin="0,0,0,10"/>
                                <StackPanel Orientation="Horizontal">
                                    <Button Content="📁  Open Folder" Style="{StaticResource PrimaryButton}"
                            Margin="0,0,8,0" Click="OpenReplaysFolder_Click"/>
                                    <Button Content="Change" Click="BrowseReplaysFolder_Click"/>
                                </StackPanel>
                            </StackPanel>

                            <!-- Not found -->
                            <StackPanel Visibility="{Binding ReplaysFound, Converter={StaticResource BoolToVisibilityConverter}}">
                                <StackPanel.Style>
                                    <Style TargetType="StackPanel">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding ReplaysFound}" Value="False">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </StackPanel.Style>
                                <TextBlock Text="Replays folder not found at the default location."
                           Foreground="#AAAAAA" FontSize="12" Margin="0,0,0,10" TextWrapping="Wrap"/>
                                <Button Content="📁  Browse for Replays Folder"
                         HorizontalAlignment="Left"
                        Click="BrowseReplaysFolder_Click"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- Gamedata -->
                    <Border Grid.Row="2" Style="{StaticResource ContentPanel}" Margin="0,0,0,10">
                        <StackPanel>
                            <TextBlock Text="🗂  Gamedata Folder"
                       Foreground="{DynamicResource AccentBrush}"
                       FontWeight="SemiBold" FontSize="13" Margin="0,0,0,8"/>

                            <StackPanel Visibility="{Binding GameDataFound, Converter={StaticResource BoolToVisibilityConverter}}">
                                <TextBlock Text="{Binding GameDataPath}" Foreground="#CCCCCC"
                           FontSize="12" TextWrapping="Wrap" Margin="0,0,0,10"/>
                                <Button Content="📁  Open Folder" Style="{StaticResource PrimaryButton}"
                         HorizontalAlignment="Left" Click="OpenGameDataFolder_Click"/>
                            </StackPanel>

                            <StackPanel>
                                <StackPanel.Style>
                                    <Style TargetType="StackPanel">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding GameDataFound}" Value="False">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </StackPanel.Style>
                                <TextBlock Text="Gamedata folder not found. Make sure your game path is set correctly in Settings."
                           Foreground="#AAAAAA" FontSize="12" TextWrapping="Wrap"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- Game.prefs -->
                    <Border Grid.Row="3" Style="{StaticResource ContentPanel}" Margin="0,0,0,10">
                        <StackPanel>
                            <TextBlock Text="⚙  Game.prefs Location"
                       Foreground="{DynamicResource AccentBrush}"
                       FontWeight="SemiBold" FontSize="13" Margin="0,0,0,8"/>

                            <StackPanel Visibility="{Binding GamePrefsFound, Converter={StaticResource BoolToVisibilityConverter}}">
                                <TextBlock Text="{Binding GamePrefsFolder}" Foreground="#CCCCCC"
                           FontSize="12" TextWrapping="Wrap" Margin="0,0,0,10"/>
                                <StackPanel Orientation="Horizontal">
                                    <Button Content="📁  Open Folder" Style="{StaticResource PrimaryButton}"
                             Margin="0,0,8,0" Click="OpenGamePrefsFolder_Click"/>
                                    <Button Content="Change"  Click="BrowseGamePrefsFolder_Click"/>
                                </StackPanel>
                            </StackPanel>

                            <StackPanel>
                                <StackPanel.Style>
                                    <Style TargetType="StackPanel">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding GamePrefsFound}" Value="False">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </StackPanel.Style>
                                <TextBlock Text="Game.prefs not found at the default location."
                           Foreground="#AAAAAA" FontSize="12" Margin="0,0,0,10" TextWrapping="Wrap"/>
                                <Button Content="📁  Browse for Game.prefs Folder"
                         HorizontalAlignment="Left"
                        Click="BrowseGamePrefsFolder_Click"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <Button Grid.Row="4" Content="← Back"
            HorizontalAlignment="Left" Click="GoToSettings"/>
                </Grid>

                <!-- ===== MANAGE MODS ===== -->
                <StackPanel x:Name="ModsView" Visibility="Collapsed">
                    <TextBlock Text="Manage Mods" Style="{StaticResource SectionHeader}"/>
                    <Border Style="{StaticResource ContentPanel}">
                        <StackPanel>
                            <Button Content="💾  Backups"   Margin="0,0,0,6" Click="GoToBackups"/>
                            <Button Content="📦  Installed" Margin="0,0,0,6" Click="GoToInstalledMods"/>
                            <Button Content="⬇  Download"  Margin="0,0,0,6" Click="GoToDownloadMods"/>
                            <Button Content="⌨  Maksing's Hotkey Mods"   Margin="0,0,0,6" Click="GoToHotkeyEditor"/>
                            <Separator Style="{StaticResource HRule}"/>
                            <Button Content="← Back" Click="GoHome" HorizontalAlignment="Left" Width="80"/>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- ===== BACKUPS ===== -->
                <StackPanel x:Name="BackupsView" Visibility="Collapsed">
                    <TextBlock Text="Backups" Style="{StaticResource SectionHeader}"/>
                    <Border Style="{StaticResource ContentPanel}">
                        <StackPanel>
                            <Button Content="💾  Save Current State as Preset" Margin="0,0,0,6" Click="GoToPresets"/>
                            <Button Content="🔍  Compare Presets"              Margin="0,0,0,6" Click="GoToComparePresets"/>
                            <Button Content="🔄  Restore Original Game Files"  Margin="0,0,0,6" Click="RestoreOriginalGameData_Click"/>
                            <Separator Style="{StaticResource HRule}"/>
                            <Button Content="← Back" Click="GoToMods" HorizontalAlignment="Left" Width="80"/>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- ===== PRESETS ===== -->
                <Grid x:Name="PresetsView" Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="Mod Presets" Style="{StaticResource SectionHeader}"/>

                    <!-- Save new preset -->
                    <Border Grid.Row="1" Style="{StaticResource ContentPanel}" Margin="0,0,0,10">
                        <StackPanel>
                            <TextBlock Text="Save Current Gamedata State as Preset"
                                       Foreground="{DynamicResource AccentBrush}"
                                       FontWeight="SemiBold" FontSize="14" Margin="0,0,0,8"/>
                            <StackPanel Orientation="Horizontal">
                                <TextBox Width="220" Margin="0,0,8,0"
                                         Text="{Binding NewPresetName, UpdateSourceTrigger=PropertyChanged}"
                                         VerticalContentAlignment="Center"/>
                                <Button Content="💾  Save" Style="{StaticResource PrimaryButton}"
                                        Width="100" Click="SavePreset_Click"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- Preset list -->
                    <Border Grid.Row="2" Style="{StaticResource ContentPanel}" Margin="0,0,0,10">
                        <ListBox x:Name="PresetsList"
                                 ItemsSource="{Binding Presets}"
                                 SelectedItem="{Binding SelectedPreset}"
                                 BorderThickness="0"
                                 Background="Transparent">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Margin="2,4">
                                        <TextBlock Text="{Binding Name}"
                                                   FontWeight="SemiBold" FontSize="14"/>
                                        <TextBlock Text="{Binding CreatedAt, StringFormat='Saved: {0:MM/dd/yyyy HH:mm}'}"
                                                   FontSize="12" Foreground="#AAAAAA"/>
                                        <TextBlock Text="{Binding Files.Count, StringFormat='{}{0} files'}"
                                                   FontSize="12" Foreground="#AAAAAA"/>
                                    </StackPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Border>

                    <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="0,0,0,8">
                        <Button Content="✅  Apply"       Style="{StaticResource PrimaryButton}"  Margin="0,0,6,0" Click="ApplyPreset_Click"/>
                        <Button Content="🗑  Delete"      Style="{StaticResource DangerButton}"   Margin="0,0,6,0" Click="DeletePreset_Click"/>
                        <Button Content="📄  View Files"   Click="ViewPresetFiles_Click"/>
                    </StackPanel>

                    <Button Grid.Row="4" Content="← Back" Width="80" HorizontalAlignment="Left" Click="GoToBackups"/>
                </Grid>

                <!-- ===== COMPARE PRESETS ===== -->
                <Grid x:Name="ComparePresetsView" Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="Compare Presets" Style="{StaticResource SectionHeader}"/>

                    <Border Grid.Row="1" Style="{StaticResource ContentPanel}" Margin="0,0,0,10">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" Margin="0,0,8,0">
                                <TextBlock Text="Left Preset" Style="{StaticResource ColumnHeader}"/>
                                <ListBox ItemsSource="{Binding ComparePresetNames}"
                     SelectedItem="{Binding CompareLeftSelection}"
                     Height="120"
                     BorderThickness="0"
                     Background="Transparent">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding}" Padding="2"/>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </StackPanel>

                            <StackPanel Grid.Column="1" Margin="8,0,0,0">
                                <TextBlock Text="Right Preset" Style="{StaticResource ColumnHeader}"/>
                                <ListBox ItemsSource="{Binding ComparePresetNames}"
                     SelectedItem="{Binding CompareRightSelection}"
                     Height="120"
                     BorderThickness="0"
                     Background="Transparent">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding}" Padding="2"/>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <Button Grid.Row="2" Content="🔍  Compare" Style="{StaticResource PrimaryButton}"
                            Width="120" HorizontalAlignment="Left" Margin="0,0,0,10"
                            Click="RunComparison_Click"/>

                    <Border Grid.Row="3" Style="{StaticResource ContentPanel}" Margin="0,0,0,10">
                        <ListBox ItemsSource="{Binding CompareResults}"
                                 BorderThickness="0" Background="Transparent">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding FileName}" Padding="2">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Foreground" Value="White"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsDifferent}" Value="True">
                                                        <Setter Property="Foreground" Value="#FF4444"/>
                                                        <Setter Property="FontWeight"  Value="Bold"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Border>

                    <Button Grid.Row="4" Content="← Back" Width="80"
                            HorizontalAlignment="Left" Click="GoToBackups"/>
                </Grid>

                <!-- ===== INSTALLED MODS CATEGORY ===== -->
                <StackPanel x:Name="InstalledModsView" Visibility="Collapsed">
                    <TextBlock Text="Installed Mods" Style="{StaticResource SectionHeader}"/>
                    <Border Style="{StaticResource ContentPanel}">
                        <StackPanel>
                            <Button Content="🗺  Custom Maps"           Margin="0,0,0,6" Click="GoToInstalledMaps"/>
                            <Button Content="⚖  Balance Mods"          Margin="0,0,0,6" IsEnabled="False"/>
                            <Button Content="🎨  Visual Mods"           Margin="0,0,0,6" IsEnabled="False"/>
                            <Button Content="🔧  Generic Gamedata Mods" Margin="0,0,0,6" Click="GoToInstalledGenericMods"/>
                            <Separator Style="{StaticResource HRule}"/>
                            <Button Content="🔍  Scan Gamedata for Unrecognized Mods" Margin="0,0,0,6" Click="GoToScanGamedata"/>
                            <Separator Style="{StaticResource HRule}"/>
                            <Button Content="← Back" Click="GoToMods" HorizontalAlignment="Left" Width="80"/>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- ===== INSTALLED: CUSTOM MAPS ===== -->
                <Grid x:Name="InstalledMapsView" Visibility="Collapsed">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="320"/>
                    </Grid.ColumnDefinitions>

                    <!-- LEFT: Lists + buttons -->
                    <Grid Grid.Column="0" Margin="0,0,8,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Text="Installed Maps" Style="{StaticResource SectionHeader}"/>

                        <!-- Filter bar -->
                        <Border Grid.Row="1" Style="{StaticResource ContentPanel}" Margin="0,0,0,8">
                            <StackPanel>
                                <Button Content="▼  Show Filters" x:Name="InstalledFiltersToggle"
                HorizontalAlignment="Left" Width="130"
                Click="InstalledFiltersToggle_Click"/>

                                <StackPanel x:Name="InstalledFiltersPanel" Visibility="Collapsed" Margin="0,10,0,0">

                                    <!-- Player Count -->
                                    <TextBlock Text="Player Count" Style="{StaticResource ColumnHeader}" Margin="0,0,0,6"/>
                                    <WrapPanel Margin="0,0,0,10">
                                        <CheckBox Content="2 Players" Margin="0,0,10,4"
                          IsChecked="{Binding InstalledMapsFilter.TagFilters[0].IsSelected, Mode=TwoWay}"
                          Checked="InstalledMapFilter_Changed" Unchecked="InstalledMapFilter_Changed"/>
                                        <CheckBox Content="3 Players" Margin="0,0,10,4"
                          IsChecked="{Binding InstalledMapsFilter.TagFilters[1].IsSelected, Mode=TwoWay}"
                          Checked="InstalledMapFilter_Changed" Unchecked="InstalledMapFilter_Changed"/>
                                        <CheckBox Content="4 Players" Margin="0,0,10,4"
                          IsChecked="{Binding InstalledMapsFilter.TagFilters[2].IsSelected, Mode=TwoWay}"
                          Checked="InstalledMapFilter_Changed" Unchecked="InstalledMapFilter_Changed"/>
                                        <CheckBox Content="5 Players" Margin="0,0,10,4"
                          IsChecked="{Binding InstalledMapsFilter.TagFilters[3].IsSelected, Mode=TwoWay}"
                          Checked="InstalledMapFilter_Changed" Unchecked="InstalledMapFilter_Changed"/>
                                        <CheckBox Content="6 Players" Margin="0,0,10,4"
                          IsChecked="{Binding InstalledMapsFilter.TagFilters[4].IsSelected, Mode=TwoWay}"
                          Checked="InstalledMapFilter_Changed" Unchecked="InstalledMapFilter_Changed"/>
                                        <CheckBox Content="7 Players" Margin="0,0,10,4"
                          IsChecked="{Binding InstalledMapsFilter.TagFilters[5].IsSelected, Mode=TwoWay}"
                          Checked="InstalledMapFilter_Changed" Unchecked="InstalledMapFilter_Changed"/>
                                        <CheckBox Content="8 Players" Margin="0,0,10,4"
                          IsChecked="{Binding InstalledMapsFilter.TagFilters[6].IsSelected, Mode=TwoWay}"
                          Checked="InstalledMapFilter_Changed" Unchecked="InstalledMapFilter_Changed"/>
                                    </WrapPanel>

                                    <!-- Gameplay -->
                                    <TextBlock Text="Gameplay" Style="{StaticResource ColumnHeader}" Margin="0,0,0,6"/>
                                    <WrapPanel Margin="0,0,0,10">
                                        <CheckBox Content="Team" Margin="0,0,10,4"
                          IsChecked="{Binding InstalledMapsFilter.TagFilters[7].IsSelected, Mode=TwoWay}"
                          Checked="InstalledMapFilter_Changed" Unchecked="InstalledMapFilter_Changed"/>
                                        <CheckBox Content="FFA" Margin="0,0,10,4"
                          IsChecked="{Binding InstalledMapsFilter.TagFilters[8].IsSelected, Mode=TwoWay}"
                          Checked="InstalledMapFilter_Changed" Unchecked="InstalledMapFilter_Changed"/>
                                        <CheckBox Content="Water" Margin="0,0,10,4"
                          IsChecked="{Binding InstalledMapsFilter.TagFilters[10].IsSelected, Mode=TwoWay}"
                          Checked="InstalledMapFilter_Changed" Unchecked="InstalledMapFilter_Changed"/>
                                    </WrapPanel>

                                    <!-- Map Size -->
                                    <TextBlock Text="Map Size" Style="{StaticResource ColumnHeader}" Margin="0,0,0,6"/>
                                    <WrapPanel Margin="0,0,0,10">
                                        <CheckBox Content="Large" Margin="0,0,10,4"
                          IsChecked="{Binding InstalledMapsFilter.TagFilters[11].IsSelected, Mode=TwoWay}"
                          Checked="InstalledMapFilter_Changed" Unchecked="InstalledMapFilter_Changed"/>
                                        <CheckBox Content="Medium" Margin="0,0,10,4"
                          IsChecked="{Binding InstalledMapsFilter.TagFilters[12].IsSelected, Mode=TwoWay}"
                          Checked="InstalledMapFilter_Changed" Unchecked="InstalledMapFilter_Changed"/>
                                        <CheckBox Content="Small" Margin="0,0,10,4"
                          IsChecked="{Binding InstalledMapsFilter.TagFilters[13].IsSelected, Mode=TwoWay}"
                          Checked="InstalledMapFilter_Changed" Unchecked="InstalledMapFilter_Changed"/>
                                    </WrapPanel>

                                    <!-- Map Pack -->
                                    <TextBlock Text="Other" Style="{StaticResource ColumnHeader}" Margin="0,0,0,6"/>
                                    <WrapPanel Margin="0,0,0,6">
                                        <CheckBox Content="Map Pack" Margin="0,0,10,4"
                          IsChecked="{Binding InstalledMapsFilter.TagFilters[9].IsSelected, Mode=TwoWay}"
                          Checked="InstalledMapFilter_Changed" Unchecked="InstalledMapFilter_Changed"/>
                                    </WrapPanel>

                                    <Button Content="Clear Filters" Width="100" HorizontalAlignment="Left"
                    Click="ClearInstalledMapFilter_Click"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <!-- Sort bar -->
                        <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,0,0,6" VerticalAlignment="Center">
                            <TextBlock Text="Sort:" Foreground="#AAAAAA" FontSize="13" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <Button Content="{Binding InstalledMapSort.NameButtonText}"  Margin="0,0,4,0"
            Click="InstalledMapSortName_Click"/>
                            <Button Content="{Binding InstalledMapSort.DateButtonText}" 
            Click="InstalledMapSortDate_Click"/>
                        </StackPanel>
                        
                        <!-- Enabled / Disabled split -->
                        <Grid Grid.Row="3" Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <Border Grid.Column="0" Style="{StaticResource ContentPanel}" Margin="0,0,5,0">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="*"/>
                                    </Grid.RowDefinitions>
                                    <TextBlock Grid.Row="0" Text="Enabled" Style="{StaticResource ColumnHeader}"/>
                                    <ListBox Grid.Row="1"
                             x:Name="EnabledMapsList"
                             ItemsSource="{Binding FilteredEnabledMaps}"
                             SelectedItem="{Binding SelectedInstalledMap}"
                             SelectionMode="Single"
                             BorderThickness="0"
                             Background="Transparent">
                                        <ListBox.ItemTemplate>
                                            <DataTemplate>
                                                <StackPanel Orientation="Horizontal">
                                                    <CheckBox IsChecked="{Binding IsChecked, Mode=TwoWay}"
                                                        VerticalAlignment="Center" Margin="0,0,6,0"
                                                        Click="MapCheckBox_Click"/>
                                                    <TextBlock Text="{Binding FileName}" VerticalAlignment="Center"/>
                                                </StackPanel>
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                    </ListBox>
                                </Grid>
                            </Border>

                            <Border Grid.Column="1" Style="{StaticResource ContentPanel}" Margin="5,0,0,0">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="*"/>
                                    </Grid.RowDefinitions>
                                    <TextBlock Grid.Row="0" Text="Disabled" Style="{StaticResource ColumnHeader}"/>
                                    <ListBox Grid.Row="1"
                             x:Name="DisabledMapsList"
                             ItemsSource="{Binding FilteredDisabledMaps}"
                             SelectedItem="{Binding SelectedInstalledMap}"
                             SelectionMode="Single"
                             BorderThickness="0"
                             Background="Transparent">
                                        <ListBox.ItemTemplate>
                                            <DataTemplate>
                                                <StackPanel Orientation="Horizontal">
                                                    <CheckBox IsChecked="{Binding IsChecked, Mode=TwoWay}"
                                                        VerticalAlignment="Center" Margin="0,0,6,0"
                                                        Click="MapCheckBox_Click"/>
                                                    <TextBlock Text="{Binding FileName}" VerticalAlignment="Center"/>
                                                </StackPanel>
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                    </ListBox>
                                </Grid>
                            </Border>
                        </Grid>

                        <StackPanel Grid.Row="4" Orientation="Horizontal" Margin="0,0,0,6">
                            <Button Content="✅  Enable Selected"   Margin="0,0,6,0" Click="EnableSelectedMaps_Click"/>
                            <Button Content="🚫  Disable Selected"  Margin="0,0,6,0" Click="DisableSelectedMaps_Click"/>
                            <Button Content="Enable All"             Margin="0,0,6,0" Click="EnableAllMaps_Click"/>
                            <Button Content="Disable All"            Click="DisableAllMaps_Click"/>
                        </StackPanel>

                        <DockPanel Grid.Row="5" LastChildFill="False">
                            <StackPanel DockPanel.Dock="Left" Orientation="Horizontal">
                                <Button Content="💾  Save"            Style="{StaticResource PrimaryButton}"   Margin="0,0,6,0" Click="SaveMaps_Click"/>
                                <Button Content="🗑  Delete Selected" Style="{StaticResource DangerButton}"   Margin="0,0,6,0" Click="DeleteSelectedMaps_Click"/>
                                <Button Content="🗑  Delete All"      Style="{StaticResource DangerButton}"   Margin="0,0,6,0" Click="DeleteAllMaps_Click"/>
                                <Button Content="← Back"               Click="GoToInstalledMods"/>
                            </StackPanel>
                            <Button DockPanel.Dock="Right" Content="⬇  Go to Download Maps" Width="180" Click="GoToDownloadMaps"/>
                        </DockPanel>
                    </Grid>

                    <!-- RIGHT: Map detail panel -->
                    <Border Grid.Column="1" Style="{StaticResource ContentPanel}">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel>
                                <!-- No map selected -->
                                <TextBlock Text="Select a map to view details"
                           Foreground="#666666" FontSize="13" TextWrapping="Wrap"
                           HorizontalAlignment="Center" Margin="0,20,0,0"
                           Visibility="{Binding SelectedInstalledMap, Converter={StaticResource NullToInverseVisibilityConverter}}"/>

                                <!-- Map selected -->
                                <StackPanel Visibility="{Binding SelectedInstalledMap, Converter={StaticResource NullToVisibilityConverter}}">

                                    <!-- Map image -->
                                    <Border Height="200" Background="#0D1117" CornerRadius="4" Margin="0,0,0,10" ClipToBounds="True">
                                        <Grid>
                                            <Image Source="{Binding SelectedInstalledMap.MapPictureUrl}"
                                   Stretch="Uniform"
                                   Visibility="{Binding SelectedInstalledMap.MapPictureUrl, Converter={StaticResource NullToVisibilityConverter}}"/>
                                            <TextBlock Text="No Image Available"
                                       Foreground="#444444" FontSize="13"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"
                                       Visibility="{Binding SelectedInstalledMap.MapPictureUrl, Converter={StaticResource NullToInverseVisibilityConverter}}"/>
                                        </Grid>
                                    </Border>

                                    <!-- Map name -->
                                    <TextBlock Text="{Binding SelectedInstalledMap.MapName}"
                               FontSize="14" FontWeight="SemiBold" TextWrapping="Wrap"
                               Margin="0,0,0,8"/>

                                    <!-- Stats -->
                                    <Grid Margin="0,0,0,6">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>

                                        <TextBlock Grid.Row="0" Grid.Column="0" Text="Author:"      Foreground="#AAAAAA" FontSize="12" Margin="0,0,8,4"/>
                                        <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding SelectedInstalledMap.Author}"      FontSize="12" TextWrapping="Wrap"/>

                                        <TextBlock Grid.Row="1" Grid.Column="0" Text="Players:"    Foreground="#AAAAAA" FontSize="12" Margin="0,0,8,4"/>
                                        <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding SelectedInstalledMap.PlayerCount}" FontSize="12"/>

                                        <TextBlock Grid.Row="2" Grid.Column="0" Text="Style:"      Foreground="#AAAAAA" FontSize="12" Margin="0,0,8,4"/>
                                        <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding SelectedInstalledMap.MapTeamStyle}" FontSize="12"/>

                                        <TextBlock Grid.Row="3" Grid.Column="0" Text="Size:"       Foreground="#AAAAAA" FontSize="12" Margin="0,0,8,4"/>
                                        <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding SelectedInstalledMap.Size}"         FontSize="12"/>

                                        <TextBlock Grid.Row="4" Grid.Column="0" Text="Version:"    Foreground="#AAAAAA" FontSize="12" Margin="0,0,8,4"/>
                                        <TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding SelectedInstalledMap.Version}"      FontSize="12"/>

                                        <TextBlock Grid.Row="5" Grid.Column="0" Text="Updated:"    Foreground="#AAAAAA" FontSize="12" Margin="0,0,8,4"/>
                                        <TextBlock Grid.Row="5" Grid.Column="1" Text="{Binding SelectedInstalledMap.LastUpdated}"  FontSize="12"/>
                                    </Grid>

                                    <Separator Style="{StaticResource HRule}"/>

                                    <!-- Description -->
                                    <TextBlock Text="{Binding SelectedInstalledMap.Description}"
                               FontSize="12" Foreground="#CCCCCC"
                               TextWrapping="Wrap" Margin="0,6,0,8"/>

                                    <!-- Tags -->
                                    <ItemsControl ItemsSource="{Binding SelectedInstalledMap.Tags}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <WrapPanel/>
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Background="{DynamicResource ButtonBaseBrush}" BorderBrush="{DynamicResource AccentBrush}"
                                        BorderThickness="1" CornerRadius="3"
                                        Padding="6,2" Margin="0,0,4,4">
                                                    <TextBlock Text="{Binding}" FontSize="11" Foreground="{DynamicResource AccentBrush}"/>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </StackPanel>
                        </ScrollViewer>
                    </Border>
                </Grid>

                <!-- ===== INSTALLED: GENERIC GAMEDATA MODS ===== -->
                <Grid x:Name="InstalledGenericModsView" Visibility="Collapsed">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="320"/>
                    </Grid.ColumnDefinitions>

                    <!-- LEFT: Lists + buttons -->
                    <Grid Grid.Column="0" Margin="0,0,8,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Text="Installed Generic Gamedata Mods" Style="{StaticResource SectionHeader}"/>

                        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,6">
                            <TextBlock Text="Sort:" Foreground="#AAAAAA" FontSize="13" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <Button Content="{Binding InstalledGenericModSort.NameButtonText}"  Margin="0,0,4,0"
                    Click="InstalledGenericModSortName_Click"/>
                            <Button Content="{Binding InstalledGenericModSort.DateButtonText}" 
                    Click="InstalledGenericModSortDate_Click"/>
                        </StackPanel>

                        <Grid Grid.Row="2" Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <Border Grid.Column="0" Style="{StaticResource ContentPanel}" Margin="0,0,5,0">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="*"/>
                                    </Grid.RowDefinitions>
                                    <TextBlock Grid.Row="0" Text="Enabled" Style="{StaticResource ColumnHeader}"/>
                                    <ListBox Grid.Row="1"
                             x:Name="EnabledGenericModsList"
                             ItemsSource="{Binding FilteredEnabledGenericMods}"
                             SelectedItem="{Binding SelectedInstalledGenericMod}"
                             SelectionMode="Single"
                             BorderThickness="0"
                             Background="Transparent">
                                        <ListBox.ItemTemplate>
                                            <DataTemplate>
                                                <StackPanel Orientation="Horizontal">
                                                    <CheckBox IsChecked="{Binding IsChecked, Mode=TwoWay}"
                                              VerticalAlignment="Center" Margin="0,0,6,0"
                                              Click="GenericModCheckBox_Click"/>
                                                    <TextBlock Text="{Binding FileName}" VerticalAlignment="Center"/>
                                                </StackPanel>
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                    </ListBox>
                                </Grid>
                            </Border>

                            <Border Grid.Column="1" Style="{StaticResource ContentPanel}" Margin="5,0,0,0">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="*"/>
                                    </Grid.RowDefinitions>
                                    <TextBlock Grid.Row="0" Text="Disabled" Style="{StaticResource ColumnHeader}"/>
                                    <ListBox Grid.Row="1"
                             x:Name="DisabledGenericModsList"
                             ItemsSource="{Binding FilteredDisabledGenericMods}"
                             SelectedItem="{Binding SelectedInstalledGenericMod}"
                             SelectionMode="Single"
                             BorderThickness="0"
                             Background="Transparent">
                                        <ListBox.ItemTemplate>
                                            <DataTemplate>
                                                <StackPanel Orientation="Horizontal">
                                                    <CheckBox IsChecked="{Binding IsChecked, Mode=TwoWay}"
                                              VerticalAlignment="Center" Margin="0,0,6,0"
                                              Click="GenericModCheckBox_Click"/>
                                                    <TextBlock Text="{Binding FileName}" VerticalAlignment="Center"/>
                                                </StackPanel>
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                    </ListBox>
                                </Grid>
                            </Border>
                        </Grid>

                        <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="0,0,0,6">
                            <Button Content="✅  Enable Selected"   Margin="0,0,6,0" Click="EnableSelectedGenericMods_Click"/>
                            <Button Content="🚫  Disable Selected"  Margin="0,0,6,0" Click="DisableSelectedGenericMods_Click"/>
                            <Button Content="Enable All"             Margin="0,0,6,0" Click="EnableAllGenericMods_Click"/>
                            <Button Content="Disable All"            Click="DisableAllGenericMods_Click"/>
                        </StackPanel>

                        <DockPanel Grid.Row="4" LastChildFill="False">
                            <StackPanel DockPanel.Dock="Left" Orientation="Horizontal">
                                <Button Content="💾  Save"            Style="{StaticResource PrimaryButton}"   Margin="0,0,6,0" Click="SaveGenericMods_Click"/>
                                <Button Content="🗑  Delete Selected" Style="{StaticResource DangerButton}"   Margin="0,0,6,0" Click="DeleteSelectedGenericMods_Click"/>
                                <Button Content="🗑  Delete All"      Style="{StaticResource DangerButton}"   Margin="0,0,6,0" Click="DeleteAllGenericMods_Click"/>
                                <Button Content="← Back"              Width="80" Click="GoToInstalledMods"/>
                            </StackPanel>
                            <Button DockPanel.Dock="Right" Content="⬇  Go to Download Mods"  Click="GoToDownloadGenericMods"/>
                        </DockPanel>
                    </Grid>

                    <!-- RIGHT: Detail panel -->
                    <Border Grid.Column="1" Style="{StaticResource ContentPanel}">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel>
                                <TextBlock Text="Select a mod to view details"
                           Foreground="#666666" FontSize="13" TextWrapping="Wrap"
                           HorizontalAlignment="Center" Margin="0,20,0,0"
                           Visibility="{Binding SelectedInstalledGenericMod, Converter={StaticResource NullToInverseVisibilityConverter}}"/>

                                <StackPanel Visibility="{Binding SelectedInstalledGenericMod, Converter={StaticResource NullToVisibilityConverter}}">

                                    <Border Height="200" Background="#0D1117" CornerRadius="4" Margin="0,0,0,10" ClipToBounds="True">
                                        <Grid>
                                            <Image Source="{Binding SelectedInstalledGenericMod.PictureUrl}"
                                   Stretch="Uniform"
                                   Visibility="{Binding SelectedInstalledGenericMod.PictureUrl, Converter={StaticResource NullToVisibilityConverter}}"/>
                                            <TextBlock Text="No Image Available"
                                       Foreground="#444444" FontSize="13"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"
                                       Visibility="{Binding SelectedInstalledGenericMod.PictureUrl, Converter={StaticResource NullToInverseVisibilityConverter}}"/>
                                        </Grid>
                                    </Border>

                                    <TextBlock Text="{Binding SelectedInstalledGenericMod.DisplayName}"
                               FontSize="14" FontWeight="SemiBold" TextWrapping="Wrap"
                               Margin="0,0,0,8"
                               Visibility="{Binding SelectedInstalledGenericMod.DisplayName, Converter={StaticResource StringToVisibilityConverter}}"/>

                                    <Grid Margin="0,0,0,6">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>

                                        <TextBlock Grid.Row="0" Grid.Column="0" Text="File:"    Foreground="#AAAAAA" FontSize="12" Margin="0,0,8,4"/>
                                        <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding SelectedInstalledGenericMod.FileName}" FontSize="12" TextWrapping="Wrap"/>

                                        <TextBlock Grid.Row="1" Grid.Column="0" Text="Author:"  Foreground="#AAAAAA" FontSize="12" Margin="0,0,8,4"/>
                                        <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding SelectedInstalledGenericMod.Author}"   FontSize="12" TextWrapping="Wrap"/>

                                        <TextBlock Grid.Row="2" Grid.Column="0" Text="Version:" Foreground="#AAAAAA" FontSize="12" Margin="0,0,8,4"/>
                                        <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding SelectedInstalledGenericMod.Version}"  FontSize="12"/>

                                        <TextBlock Grid.Row="3" Grid.Column="0" Text="Updated:" Foreground="#AAAAAA" FontSize="12" Margin="0,0,8,4"/>
                                        <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding SelectedInstalledGenericMod.LastUpdated}" FontSize="12"/>
                                    </Grid>

                                    <Separator Style="{StaticResource HRule}"/>

                                    <TextBlock Text="{Binding SelectedInstalledGenericMod.Description}"
                               FontSize="12" Foreground="#CCCCCC"
                               TextWrapping="Wrap" Margin="0,6,0,0"/>
                                </StackPanel>
                            </StackPanel>
                        </ScrollViewer>
                    </Border>
                </Grid>

                <!-- ===== SCAN GAMEDATA ===== -->
                <Grid x:Name="ScanGamedataView" Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="Scan Gamedata" Style="{StaticResource SectionHeader}"/>

                    <!-- Warning banner -->
                    <Border Grid.Row="1" Background="#1A2200" BorderBrush="#AA8800"
            BorderThickness="1" CornerRadius="4" Padding="12,10" Margin="0,0,0,12">
                        <StackPanel>
                            <TextBlock Text="⚠  Before you import" Foreground="#FFCC00"
                       FontWeight="SemiBold" FontSize="14" Margin="0,0,0,6"/>
                            <TextBlock TextWrapping="Wrap" Foreground="#DDDDDD" FontSize="13" LineHeight="18">
                <Run>Unknown files will be imported as </Run>
                <Run FontWeight="Bold" Foreground="White">Generic Gamedata Mods</Run>
                <Run>. If deleted from the mod manager they cannot be restored automatically.</Run>
                            </TextBlock>
                        </StackPanel>
                    </Border>

                    <!-- SECTION 1: Matches downloadable list -->
                    <Border Grid.Row="2" Style="{StaticResource ContentPanel}" Margin="0,0,0,8">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Style="{StaticResource ColumnHeader}"
                       Text="Found in Downloadable List"/>

                            <TextBlock Grid.Row="1" TextWrapping="Wrap" Foreground="#AAAAAA" FontSize="12"
                       Margin="0,0,0,8">
                These files match mods available for download. You can import them so the mod manager
                tracks them with full metadata, or delete them and re-download cleanly later.
                            </TextBlock>

                            <ListBox Grid.Row="2"
                     x:Name="ScanMatchResultsList"
                     ItemsSource="{Binding ScanMatchResults}"
                     BorderThickness="0"
                     Background="Transparent">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <CheckBox Content="{Binding FileName}"
                                  IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                  Margin="2,3"/>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </Grid>
                    </Border>

                    <!-- Action buttons for matched mods -->
                    <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="0,0,0,12">
                        <Button Content="Select All"   Margin="0,0,6,0" Click="SelectAllMatchResults_Click"/>
                        <Button Content="Deselect All"  Margin="0,0,6,0" Click="DeselectAllMatchResults_Click"/>
                        <Button Content="📥  Import &amp; Track" Style="{StaticResource PrimaryButton}"
                 Margin="0,0,6,0" Click="ImportMatchedMods_Click"/>
                        <Button Content="🗑  Delete Selected" Style="{StaticResource DangerButton}"
                 Click="DeleteMatchedMods_Click"/>
                    </StackPanel>

                    <!-- SECTION 2: Fully unknown -->
                    <Border Grid.Row="4" Style="{StaticResource ContentPanel}" Margin="0,0,0,8">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Style="{StaticResource ColumnHeader}"
                       Text="Unrecognized Files"/>

                            <TextBlock Grid.Row="1" TextWrapping="Wrap" Foreground="#AAAAAA" FontSize="12"
                       Margin="0,0,0,8">
                These files are not original game files and do not match any known downloadable mod.
                Import them as Generic Gamedata Mods to manage them, or leave them alone.
                            </TextBlock>

                            <ListBox Grid.Row="2"
                     x:Name="ScanResultsList"
                     ItemsSource="{Binding ScanResults}"
                     BorderThickness="0"
                     Background="Transparent">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <CheckBox Content="{Binding FileName}"
                                  IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                  Margin="2,3"/>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </Grid>
                    </Border>

                    <!-- Action buttons for unknown mods -->
                    <StackPanel Grid.Row="5" Orientation="Horizontal" Margin="0,0,0,8">
                        <Button Content="Select All"     Margin="0,0,6,0" Click="SelectAllScanResults_Click"/>
                        <Button Content="Deselect All"   Margin="0,0,6,0" Click="DeselectAllScanResults_Click"/>
                        <Button Content="📥  Import Selected" Style="{StaticResource PrimaryButton}"
             Margin="0,0,6,0" Click="ImportScanResults_Click"/>
                        <Button Content="🗑  Delete Selected" Style="{StaticResource DangerButton}"
             Click="DeleteUnknownFiles_Click"/>
                    </StackPanel>

                    <!-- Run scan / Back -->
                    <StackPanel Grid.Row="6" Orientation="Horizontal">
                        <Button Content="🔍  Run Scan" Style="{StaticResource PrimaryButton}"
                 Margin="0,0,6,0" Click="RunScan_Click"/>
                        <Button Content="← Back"  Click="GoToInstalledMods"/>
                    </StackPanel>
                </Grid>

                <!-- ===== DOWNLOAD MODS CATEGORY ===== -->
                <StackPanel x:Name="DownloadModsView" Visibility="Collapsed">
                    <TextBlock Text="Download Mods" Style="{StaticResource SectionHeader}"/>
                    <Border Style="{StaticResource ContentPanel}">
                        <StackPanel>
                            <Button Content="🗺  Custom Maps"           Margin="0,0,0,6" Click="GoToDownloadMaps"/>
                            <Button Content="⚖  Balance Mods"          Margin="0,0,0,6" IsEnabled="False"/>
                            <Button Content="🎨  Visual Mods"           Margin="0,0,0,6" IsEnabled="False"/>
                            <Button Content="🔧  Generic Gamedata Mods" Margin="0,0,0,6" Click="GoToDownloadGenericMods"/>
                            <Button Content="📂  Manual Import"         Margin="0,0,0,6" Click="GoToManualImport"/>
                            <Separator Style="{StaticResource HRule}"/>
                            <Button Content="← Back" Click="GoToMods" HorizontalAlignment="Left" />
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- ===== DOWNLOAD: CUSTOM MAPS ===== -->
                <Grid x:Name="DownloadMapsView" Visibility="Collapsed">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="320"/>
                    </Grid.ColumnDefinitions>

                    <!-- LEFT: List + buttons -->
                    <Grid Grid.Column="0" Margin="0,0,8,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Text="Download Custom Maps" Style="{StaticResource SectionHeader}"/>

                        <!-- Filter bar -->
                        <Border Grid.Row="1" Style="{StaticResource ContentPanel}" Margin="0,0,0,8">
                            <StackPanel>
                                <Button Content="▼  Show Filters" x:Name="DownloadFiltersToggle"
HorizontalAlignment="Left" Width="130"
Click="DownloadFiltersToggle_Click"/>

                                <StackPanel x:Name="DownloadFiltersPanel" Visibility="Collapsed" Margin="0,10,0,0">

                                    <!-- Player Count -->
                                    <TextBlock Text="Player Count" Style="{StaticResource ColumnHeader}" Margin="0,0,0,6"/>
                                    <WrapPanel Margin="0,0,0,10">
                                        <CheckBox Content="2 Players" Margin="0,0,10,4"
          IsChecked="{Binding DownloadMapsFilter.TagFilters[0].IsSelected, Mode=TwoWay}"
          Checked="DownloadMapFilter_Changed" Unchecked="DownloadMapFilter_Changed"/>
                                        <CheckBox Content="3 Players" Margin="0,0,10,4"
          IsChecked="{Binding DownloadMapsFilter.TagFilters[1].IsSelected, Mode=TwoWay}"
          Checked="DownloadMapFilter_Changed" Unchecked="DownloadMapFilter_Changed"/>
                                        <CheckBox Content="4 Players" Margin="0,0,10,4"
          IsChecked="{Binding DownloadMapsFilter.TagFilters[2].IsSelected, Mode=TwoWay}"
          Checked="DownloadMapFilter_Changed" Unchecked="DownloadMapFilter_Changed"/>
                                        <CheckBox Content="5 Players" Margin="0,0,10,4"
          IsChecked="{Binding DownloadMapsFilter.TagFilters[3].IsSelected, Mode=TwoWay}"
          Checked="DownloadMapFilter_Changed" Unchecked="DownloadMapFilter_Changed"/>
                                        <CheckBox Content="6 Players" Margin="0,0,10,4"
          IsChecked="{Binding DownloadMapsFilter.TagFilters[4].IsSelected, Mode=TwoWay}"
          Checked="DownloadMapFilter_Changed" Unchecked="DownloadMapFilter_Changed"/>
                                        <CheckBox Content="7 Players" Margin="0,0,10,4"
          IsChecked="{Binding DownloadMapsFilter.TagFilters[5].IsSelected, Mode=TwoWay}"
          Checked="DownloadMapFilter_Changed" Unchecked="DownloadMapFilter_Changed"/>
                                        <CheckBox Content="8 Players" Margin="0,0,10,4"
          IsChecked="{Binding DownloadMapsFilter.TagFilters[6].IsSelected, Mode=TwoWay}"
          Checked="DownloadMapFilter_Changed" Unchecked="DownloadMapFilter_Changed"/>
                                    </WrapPanel>

                                    <!-- Gameplay -->
                                    <TextBlock Text="Gameplay" Style="{StaticResource ColumnHeader}" Margin="0,0,0,6"/>
                                    <WrapPanel Margin="0,0,0,10">
                                        <CheckBox Content="Team" Margin="0,0,10,4"
          IsChecked="{Binding DownloadMapsFilter.TagFilters[7].IsSelected, Mode=TwoWay}"
          Checked="DownloadMapFilter_Changed" Unchecked="DownloadMapFilter_Changed"/>
                                        <CheckBox Content="FFA" Margin="0,0,10,4"
          IsChecked="{Binding DownloadMapsFilter.TagFilters[8].IsSelected, Mode=TwoWay}"
          Checked="DownloadMapFilter_Changed" Unchecked="DownloadMapFilter_Changed"/>
                                        <CheckBox Content="Water" Margin="0,0,10,4"
          IsChecked="{Binding DownloadMapsFilter.TagFilters[10].IsSelected, Mode=TwoWay}"
          Checked="DownloadMapFilter_Changed" Unchecked="DownloadMapFilter_Changed"/>
                                    </WrapPanel>

                                    <!-- Map Size -->
                                    <TextBlock Text="Map Size" Style="{StaticResource ColumnHeader}" Margin="0,0,0,6"/>
                                    <WrapPanel Margin="0,0,0,10">
                                        <CheckBox Content="Large" Margin="0,0,10,4"
          IsChecked="{Binding DownloadMapsFilter.TagFilters[11].IsSelected, Mode=TwoWay}"
          Checked="DownloadMapFilter_Changed" Unchecked="DownloadMapFilter_Changed"/>
                                        <CheckBox Content="Medium" Margin="0,0,10,4"
          IsChecked="{Binding DownloadMapsFilter.TagFilters[12].IsSelected, Mode=TwoWay}"
          Checked="DownloadMapFilter_Changed" Unchecked="DownloadMapFilter_Changed"/>
                                        <CheckBox Content="Small" Margin="0,0,10,4"
          IsChecked="{Binding DownloadMapsFilter.TagFilters[13].IsSelected, Mode=TwoWay}"
          Checked="DownloadMapFilter_Changed" Unchecked="DownloadMapFilter_Changed"/>
                                    </WrapPanel>

                                    <!-- Map Pack -->
                                    <TextBlock Text="Other" Style="{StaticResource ColumnHeader}" Margin="0,0,0,6"/>
                                    <WrapPanel Margin="0,0,0,6">
                                        <CheckBox Content="Map Pack" Margin="0,0,10,4"
          IsChecked="{Binding DownloadMapsFilter.TagFilters[9].IsSelected, Mode=TwoWay}"
          Checked="DownloadMapFilter_Changed" Unchecked="DownloadMapFilter_Changed"/>
                                    </WrapPanel>

                                    <Button Content="Clear Filters" Width="100" HorizontalAlignment="Left"
    Click="ClearDownloadMapFilter_Click"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <!-- Sort bar -->
                        <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,0,0,6">
                            <TextBlock Text="Sort:" Foreground="#AAAAAA" FontSize="13" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <Button Content="{Binding DownloadMapSort.NameButtonText}" Width="75" Margin="0,0,4,0"
            Click="DownloadMapSortName_Click"/>
                            <Button Content="{Binding DownloadMapSort.DateButtonText}" Width="75"
            Click="DownloadMapSortDate_Click"/>
                        </StackPanel>

                        <Border Grid.Row="3" Style="{StaticResource ContentPanel}" Margin="0,0,0,8">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>
                                <TextBlock Grid.Row="0" Text="Available Maps" Style="{StaticResource ColumnHeader}"/>
                                
                                <ListBox Grid.Row="1"
                         x:Name="DownloadMapsList"
                         ItemsSource="{Binding FilteredDownloadableMaps}"
                         SelectedItem="{Binding SelectedDownloadMap}"
                         SelectionMode="Single"
                         BorderThickness="0"
                         Background="Transparent">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal" Margin="2">
                                                <CheckBox IsChecked="{Binding IsChecked, Mode=TwoWay}"
                                                  VerticalAlignment="Center" Margin="0,0,6,0"
                                                  Click="MapCheckBox_Click"/>
                                                <TextBlock Text="{Binding FileName}" VerticalAlignment="Center"/>
                                                <TextBlock Text="  ⏳ Queued" Foreground="#CCCC00"
                                           FontSize="12" VerticalAlignment="Center"
                                           Visibility="{Binding IsQueued, Converter={StaticResource BoolToVisibilityConverter}}"/>
                                                <TextBlock Text="  ⬇ Downloading" Foreground="#CCCC00"
                                           FontSize="12" VerticalAlignment="Center"
                                           Visibility="{Binding IsDownloading, Converter={StaticResource BoolToVisibilityConverter}}"/>
                                                <TextBlock Text="  ✔ Downloaded" Foreground="#44CC44"
                                           FontSize="12" VerticalAlignment="Center"
                                           Visibility="{Binding IsDownloaded, Converter={StaticResource BoolToVisibilityConverter}}"/>
                                                <TextBlock Text="  ✖ Failed" Foreground="#CC4444"
                                           FontSize="12" VerticalAlignment="Center"
                                           Visibility="{Binding DownloadFailed, Converter={StaticResource BoolToVisibilityConverter}}"/>
                                            </StackPanel>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </Grid>
                        </Border>

                        <StackPanel Grid.Row="4" Orientation="Horizontal" Margin="0,0,0,8">
                            <Button Content="Select All"   Width="100" Margin="0,0,6,0" Click="SelectAllDownloadMaps_Click"/>
                            <Button Content="Deselect All" Width="100" Margin="0,0,6,0" Click="DeselectAllDownloadMaps_Click"/>
                            <Button Content="⬇  Download" Style="{StaticResource PrimaryButton}" Width="110" Click="DownloadSelectedMaps_Click"/>
                        </StackPanel>

                        <DockPanel Grid.Row="5" LastChildFill="False">
                            <Button DockPanel.Dock="Left"  Content="← Back"                    Width="80"  Click="GoToDownloadMods"/>
                            <Button DockPanel.Dock="Right" Content="📦  Go to Installed Maps"  Width="180" Click="GoToInstalledMaps"/>
                        </DockPanel>
                    </Grid>

                    <!-- RIGHT: Map detail panel -->
                    <Border Grid.Column="1" Style="{StaticResource ContentPanel}">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel>
                                <TextBlock Text="Select a map to view details"
                           Foreground="#666666" FontSize="13" TextWrapping="Wrap"
                           HorizontalAlignment="Center" Margin="0,20,0,0"
                           Visibility="{Binding SelectedDownloadMap, Converter={StaticResource NullToInverseVisibilityConverter}}"/>

                                <StackPanel Visibility="{Binding SelectedDownloadMap, Converter={StaticResource NullToVisibilityConverter}}">

                                    <Border Height="200" Background="#0D1117" CornerRadius="4" Margin="0,0,0,10" ClipToBounds="True">
                                        <Grid>
                                            <Image Source="{Binding SelectedDownloadMap.MapPictureUrl}"
                                   Stretch="Uniform"
                                   Visibility="{Binding SelectedDownloadMap.MapPictureUrl, Converter={StaticResource NullToVisibilityConverter}}"/>
                                            <TextBlock Text="No Image Available"
                                       Foreground="#444444" FontSize="13"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"
                                       Visibility="{Binding SelectedDownloadMap.MapPictureUrl, Converter={StaticResource NullToInverseVisibilityConverter}}"/>
                                        </Grid>
                                    </Border>

                                    <TextBlock Text="{Binding SelectedDownloadMap.MapName}"
                               FontSize="14" FontWeight="SemiBold" TextWrapping="Wrap"
                               Margin="0,0,0,8"/>

                                    <Grid Margin="0,0,0,6">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>

                                        <TextBlock Grid.Row="0" Grid.Column="0" Text="Author:"   Foreground="#AAAAAA" FontSize="12" Margin="0,0,8,4"/>
                                        <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding SelectedDownloadMap.Author}"       FontSize="12" TextWrapping="Wrap"/>

                                        <TextBlock Grid.Row="1" Grid.Column="0" Text="Players:"  Foreground="#AAAAAA" FontSize="12" Margin="0,0,8,4"/>
                                        <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding SelectedDownloadMap.PlayerCount}"  FontSize="12"/>

                                        <TextBlock Grid.Row="2" Grid.Column="0" Text="Style:"    Foreground="#AAAAAA" FontSize="12" Margin="0,0,8,4"/>
                                        <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding SelectedDownloadMap.MapTeamStyle}" FontSize="12"/>

                                        <TextBlock Grid.Row="3" Grid.Column="0" Text="Size:"     Foreground="#AAAAAA" FontSize="12" Margin="0,0,8,4"/>
                                        <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding SelectedDownloadMap.Size}"         FontSize="12"/>

                                        <TextBlock Grid.Row="4" Grid.Column="0" Text="Version:"  Foreground="#AAAAAA" FontSize="12" Margin="0,0,8,4"/>
                                        <TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding SelectedDownloadMap.Version}"      FontSize="12"/>

                                        <TextBlock Grid.Row="5" Grid.Column="0" Text="Updated:"  Foreground="#AAAAAA" FontSize="12" Margin="0,0,8,4"/>
                                        <TextBlock Grid.Row="5" Grid.Column="1" Text="{Binding SelectedDownloadMap.LastUpdated}"  FontSize="12"/>
                                    </Grid>

                                    <Separator Style="{StaticResource HRule}"/>

                                    <TextBlock Text="{Binding SelectedDownloadMap.Description}"
                               FontSize="12" Foreground="#CCCCCC"
                               TextWrapping="Wrap" Margin="0,6,0,8"/>

                                    <ItemsControl ItemsSource="{Binding SelectedDownloadMap.Tags}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <WrapPanel/>
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Background="{DynamicResource ButtonBaseBrush}" BorderBrush="{DynamicResource AccentBrush}"
                                        BorderThickness="1" CornerRadius="3"
                                        Padding="6,2" Margin="0,0,4,4">
                                                    <TextBlock Text="{Binding}" FontSize="11" Foreground="{StaticResource AccentBrush}"/>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </StackPanel>
                        </ScrollViewer>
                    </Border>
                </Grid>

                <!-- ===== DOWNLOAD: GENERIC GAMEDATA MODS ===== -->
                <Grid x:Name="DownloadGenericModsView" Visibility="Collapsed">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="320"/>
                    </Grid.ColumnDefinitions>

                    <!-- LEFT -->
                    <Grid Grid.Column="0" Margin="0,0,8,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Text="Download Generic Gamedata Mods" Style="{StaticResource SectionHeader}"/>

                        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,6">
                            <TextBlock Text="Sort:" Foreground="#AAAAAA" FontSize="13" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <Button Content="{Binding DownloadGenericModSort.NameButtonText}" Width="75" Margin="0,0,4,0"
                    Click="DownloadGenericModSortName_Click"/>
                            <Button Content="{Binding DownloadGenericModSort.DateButtonText}" Width="75"
                    Click="DownloadGenericModSortDate_Click"/>
                        </StackPanel>

                        <Border Grid.Row="2" Style="{StaticResource ContentPanel}" Margin="0,0,0,10">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>
                                <TextBlock Grid.Row="0" Text="Available Mods" Style="{StaticResource ColumnHeader}"/>
                                <ListBox Grid.Row="1"
                         x:Name="DownloadGenericModsList"
                         ItemsSource="{Binding FilteredDownloadableGenericMods}"
                         SelectedItem="{Binding SelectedDownloadGenericMod}"
                         SelectionMode="Single"
                         BorderThickness="0"
                         Background="Transparent">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal" Margin="2">
                                                <CheckBox IsChecked="{Binding IsChecked, Mode=TwoWay}"
                                          VerticalAlignment="Center" Margin="0,0,6,0"
                                          Click="GenericModCheckBox_Click"/>
                                                <TextBlock Text="{Binding FileName}" VerticalAlignment="Center"/>
                                                <TextBlock Text="  ⏳ Queued" Foreground="#CCCC00"
                                           FontSize="12" VerticalAlignment="Center"
                                           Visibility="{Binding IsQueued, Converter={StaticResource BoolToVisibilityConverter}}"/>
                                                <TextBlock Text="  ⬇ Downloading" Foreground="#CCCC00"
                                           FontSize="12" VerticalAlignment="Center"
                                           Visibility="{Binding IsDownloading, Converter={StaticResource BoolToVisibilityConverter}}"/>
                                                <TextBlock Text="  ✔ Downloaded" Foreground="#44CC44"
                                           FontSize="12" VerticalAlignment="Center"
                                           Visibility="{Binding IsDownloaded, Converter={StaticResource BoolToVisibilityConverter}}"/>
                                                <TextBlock Text="  ✖ Failed" Foreground="#CC4444"
                                           FontSize="12" VerticalAlignment="Center"
                                           Visibility="{Binding DownloadFailed, Converter={StaticResource BoolToVisibilityConverter}}"/>
                                            </StackPanel>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </Grid>
                        </Border>

                        <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="0,0,0,8">
                            <Button Content="Select All"   Width="100" Margin="0,0,6,0" Click="SelectAllDownloadGenericMods_Click"/>
                            <Button Content="Deselect All" Width="100" Margin="0,0,6,0" Click="DeselectAllDownloadGenericMods_Click"/>
                            <Button Content="⬇  Download" Style="{StaticResource PrimaryButton}" Width="110" Click="DownloadSelectedGenericMods_Click"/>
                        </StackPanel>

                        <DockPanel Grid.Row="4" LastChildFill="False">
                            <Button DockPanel.Dock="Left"  Content="← Back"                   Width="80"  Click="GoToDownloadMods"/>
                            <Button DockPanel.Dock="Right" Content="📦  Go to Installed Mods" Width="200" Click="GoToInstalledGenericMods"/>
                        </DockPanel>
                    </Grid>

                    <!-- RIGHT: Detail panel -->
                    <Border Grid.Column="1" Style="{StaticResource ContentPanel}">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel>
                                <TextBlock Text="Select a mod to view details"
                           Foreground="#666666" FontSize="13" TextWrapping="Wrap"
                           HorizontalAlignment="Center" Margin="0,20,0,0"
                           Visibility="{Binding SelectedDownloadGenericMod, Converter={StaticResource NullToInverseVisibilityConverter}}"/>

                                <StackPanel Visibility="{Binding SelectedDownloadGenericMod, Converter={StaticResource NullToVisibilityConverter}}">

                                    <Border Height="200" Background="#0D1117" CornerRadius="4" Margin="0,0,0,10" ClipToBounds="True">
                                        <Grid>
                                            <Image Source="{Binding SelectedDownloadGenericMod.PictureUrl}"
                                   Stretch="Uniform"
                                   Visibility="{Binding SelectedDownloadGenericMod.PictureUrl, Converter={StaticResource NullToVisibilityConverter}}"/>
                                            <TextBlock Text="No Image Available"
                                       Foreground="#444444" FontSize="13"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"
                                       Visibility="{Binding SelectedDownloadGenericMod.PictureUrl, Converter={StaticResource NullToInverseVisibilityConverter}}"/>
                                        </Grid>
                                    </Border>

                                    <TextBlock Text="{Binding SelectedDownloadGenericMod.DisplayName}"
                               FontSize="14" FontWeight="SemiBold" TextWrapping="Wrap"
                               Margin="0,0,0,8"
                               Visibility="{Binding SelectedDownloadGenericMod.DisplayName, Converter={StaticResource StringToVisibilityConverter}}"/>

                                    <Grid Margin="0,0,0,6">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>

                                        <TextBlock Grid.Row="0" Grid.Column="0" Text="File:"    Foreground="#AAAAAA" FontSize="12" Margin="0,0,8,4"/>
                                        <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding SelectedDownloadGenericMod.FileName}"    FontSize="12" TextWrapping="Wrap"/>

                                        <TextBlock Grid.Row="1" Grid.Column="0" Text="Author:"  Foreground="#AAAAAA" FontSize="12" Margin="0,0,8,4"/>
                                        <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding SelectedDownloadGenericMod.Author}"      FontSize="12" TextWrapping="Wrap"/>

                                        <TextBlock Grid.Row="2" Grid.Column="0" Text="Version:" Foreground="#AAAAAA" FontSize="12" Margin="0,0,8,4"/>
                                        <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding SelectedDownloadGenericMod.Version}"     FontSize="12"/>

                                        <TextBlock Grid.Row="3" Grid.Column="0" Text="Updated:" Foreground="#AAAAAA" FontSize="12" Margin="0,0,8,4"/>
                                        <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding SelectedDownloadGenericMod.LastUpdated}" FontSize="12"/>
                                    </Grid>

                                    <Separator Style="{StaticResource HRule}"/>

                                    <TextBlock Text="{Binding SelectedDownloadGenericMod.Description}"
                               FontSize="12" Foreground="#CCCCCC"
                               TextWrapping="Wrap" Margin="0,6,0,0"/>
                                </StackPanel>
                            </StackPanel>
                        </ScrollViewer>
                    </Border>
                </Grid>

                <!-- ===== MANUAL IMPORT ===== -->
                <Grid x:Name="ManualImportView" Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="Manual Import" Style="{StaticResource SectionHeader}"/>

                    <Border Grid.Row="1"
                            x:Name="DropZone"
                            BorderBrush="{DynamicResource AccentBrush}"
                            BorderThickness="2"
                            Background="#110D1117"
                            CornerRadius="6"
                            AllowDrop="True"
                            Drop="ManualImport_Drop"
                            DragOver="ManualImport_DragOver"
                            Margin="0,0,0,12">
                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                            <TextBlock Text="📂" FontSize="40" HorizontalAlignment="Center" Margin="0,0,0,8"/>
                            <TextBlock Text="Drag and drop .scd or .zip files here"
                                       FontSize="16" Foreground="#AAAAAA" HorizontalAlignment="Center"/>
                            <TextBlock Text="or" Margin="0,10" HorizontalAlignment="Center" Foreground="#666666"/>
                            <Button Content="Browse for File" Style="{StaticResource PrimaryButton}"
                                    Width="150" Click="ManualImportBrowse_Click"/>
                        </StackPanel>
                    </Border>

                    <Button Grid.Row="2" Content="← Back" Width="80"
                            HorizontalAlignment="Left" Click="GoToDownloadMods"/>
                </Grid>

                <!-- ===== HOTKEY EDITOR ===== -->
                <Grid x:Name="HotkeyEditorView" Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <DockPanel Grid.Row="0" Margin="0,0,0,16">
                        <Button DockPanel.Dock="Left" Content="← Back"
                                Click="GoToMods"
                                HorizontalAlignment="Left" Width="80" Margin="0,0,12,0"
                                VerticalAlignment="Center"/>
                        <TextBlock Text="Maksing's Hotkey Mods"
                                   Foreground="White" FontSize="24" FontFamily="Segoe UI"
                                   FontWeight="Light" VerticalAlignment="Center"/>
                    </DockPanel>

                    <TabControl Grid.Row="1"
                                Background="Transparent"
                                BorderBrush="#33FFFFFF"
                                Foreground="White">
                        <TabControl.Resources>
                            <Style TargetType="TabItem">
                                <Setter Property="Foreground" Value="#AAAAAA"/>
                                <Setter Property="Background" Value="Transparent"/>
                                <Setter Property="Padding" Value="18,10"/>
                                <Setter Property="Cursor" Value="Hand"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="TabItem">
                                            <Border x:Name="Bd"
                                                    Background="{TemplateBinding Background}"
                                                    BorderBrush="{DynamicResource AccentBrush}"
                                                    BorderThickness="0,0,0,2"
                                                    Margin="0,0,8,0"
                                                    Padding="{TemplateBinding Padding}"
                                                    TextBlock.Foreground="{TemplateBinding Foreground}">
                                                <ContentPresenter ContentSource="Header"
                                                                  HorizontalAlignment="Center"
                                                                  VerticalAlignment="Center"/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsSelected" Value="True">
                                                    <Setter TargetName="Bd" Property="Background" Value="#1A2535"/>
                                                    <Setter TargetName="Bd" Property="BorderThickness" Value="0,0,0,3"/>
                                                    <Setter Property="Foreground" Value="White"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </TabControl.Resources>

                        <!-- ══ TAB 1: Normal Hotkeys ══════════════════════════════════════════ -->
                        <TabItem Header="Normal Hotkeys  (luo.scd)">
                            <Grid Margin="0,8,0,0">
                                <!-- NOT INSTALLED -->
                                <Border Style="{StaticResource ContentPanel}"
                                        Visibility="{Binding HotkeyEditor.IsNormalModInstalled, Converter={StaticResource InverseBoolToVisConverter}}">
                                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Width="460">
                                        <TextBlock Text="⌨  Normal Hotkey Mod Not Installed"
                                                   FontSize="18" FontWeight="SemiBold" Foreground="White"
                                                   HorizontalAlignment="Center" Margin="0,0,0,12"/>
                                        <TextBlock TextWrapping="Wrap" Foreground="#CCCCCC" FontSize="13"
                                                   HorizontalAlignment="Center" TextAlignment="Center" Margin="0,0,0,16">
                                            The hotkey mod (luo.scd) adds and customises unit ability hotkeys.
                                            Click below and the mod manager will download and install it automatically.
                                        </TextBlock>
                                        <Button Content="⬇  Download &amp; Install"
                                                Style="{StaticResource PrimaryButton}"
                                                HorizontalAlignment="Center" Width="200"
                                                IsEnabled="{Binding HotkeyEditor.IsNormalDownloading, Converter={StaticResource InverseBoolConverter}}"
                                                Click="DownloadAndInstallNormalHotkey_Click"
                                                Visibility="{Binding HotkeyEditor.IsNormalDownloading, Converter={StaticResource InverseBoolToVisConverter}}"/>
                                        <TextBlock Text="Downloading..."
                                                   Foreground="{DynamicResource AccentBrush}" FontSize="14"
                                                   HorizontalAlignment="Center"
                                                   Visibility="{Binding HotkeyEditor.IsNormalDownloading, Converter={StaticResource BoolToVisConverter}}"/>
                                    </StackPanel>
                                </Border>

                                <!-- INSTALLED EDITOR -->
                                <Grid Visibility="{Binding HotkeyEditor.IsNormalModInstalled, Converter={StaticResource BoolToVisConverter}}">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="*"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>

                                    <!-- Instructions -->
                                    <Border Grid.Row="0" Background="#0D1A2A" BorderBrush="#22AACCFF" BorderThickness="1"
                                            CornerRadius="6" Padding="14,10" Margin="0,0,0,10">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="⌨" FontSize="22" VerticalAlignment="Center"
                                                       Foreground="{DynamicResource AccentBrush}" Margin="0,0,10,0"/>
                                            <StackPanel>
                                                <TextBlock Text="How to edit hotkeys" Foreground="White" FontWeight="SemiBold" FontSize="13"/>
                                                <TextBlock Foreground="#AAAAAA" FontSize="12" Margin="0,3,0,0" TextWrapping="Wrap">
                                                    Click any <Run Foreground="{DynamicResource AccentBrush}" FontWeight="SemiBold">Key Binding</Run> cell and type your new key combination.
                                                    Use modifiers with a dash, e.g. <Run Foreground="{DynamicResource AccentBrush}">Ctrl-B</Run> or <Run Foreground="{DynamicResource AccentBrush}">Alt-M</Run>.
                                                    Then click <Run Foreground="{DynamicResource AccentBrush}" FontWeight="SemiBold">Save &amp; Apply to Game</Run>.
                                                </TextBlock>
                                            </StackPanel>
                                        </StackPanel>
                                    </Border>

                                    <!-- Mode toggle -->
                                    <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,8">
                                        <TextBlock Text="Mode:" Foreground="#AAAAAA" FontSize="13"
                                                   VerticalAlignment="Center" Margin="0,0,8,0"/>
                                        <RadioButton x:Name="NormalHotkeyNormalModeRadio"
                                                     Content="Normal"
                                                     IsChecked="{Binding HotkeyEditor.IsNormalAdvancedMode,
                                                         Converter={StaticResource InverseBoolConverter}}"
                                                     Margin="0,0,12,0" VerticalAlignment="Center"
                                                     Foreground="White"/>
                                        <RadioButton Content="Advanced (Raw Lua)"
                                                     IsChecked="{Binding HotkeyEditor.IsNormalAdvancedMode}"
                                                     VerticalAlignment="Center" Foreground="White"/>
                                    </StackPanel>

                                    <!-- Normal mode: three expandable sections -->
                                    <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto"
                                                  Visibility="{Binding HotkeyEditor.IsNormalAdvancedMode,
                                                      Converter={StaticResource InverseBoolToVisConverter}}">
                                        <StackPanel>
                                            <!-- Duplicate key legend -->
                                            <TextBlock Margin="0,0,0,8" FontSize="11" Foreground="#AAAAAA">
                                                <Run Foreground="#FF6666" FontWeight="Bold" FontSize="14">&#x25A0; </Run>
                                                <Run>= Duplicate key binding within this section</Run>
                                            </TextBlock>

                                            <Expander Header="Main Hotkeys" IsExpanded="True"
                                                      Foreground="White" Margin="0,0,0,8">
                                                <DataGrid ItemsSource="{Binding HotkeyEditor.MainHotkeys}"
                                                          x:Name="MainHotkeysGrid"
                                                          AutoGenerateColumns="False"
                                                          CanUserAddRows="False"
                                                          CanUserDeleteRows="False"
                                                          HeadersVisibility="Column"
                                                          GridLinesVisibility="Horizontal"
                                                          Background="Transparent"
                                                          Foreground="White"
                                                          BorderThickness="0"
                                                          ColumnHeaderHeight="28"
                                                          RowHeight="30"
                                                          Margin="0,4,0,0"
                                                          PreviewMouseWheel="HotkeyDataGrid_PreviewMouseWheel">
                                                    <DataGrid.RowStyle>
                                                        <Style TargetType="DataGridRow">
                                                            <Setter Property="Background" Value="#111820"/>
                                                            <Setter Property="Foreground" Value="White"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsDuplicate}" Value="True">
                                                                    <Setter Property="Background" Value="#4D1A0A"/>
                                                                    <Setter Property="Foreground" Value="#FF8080"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </DataGrid.RowStyle>
                                                    <DataGrid.Columns>
                                                        <DataGridTemplateColumn Header="Key Binding" Width="140">
                                                            <DataGridTemplateColumn.CellTemplate>
                                                                <DataTemplate>
                                                                    <TextBox Text="{Binding KeyCombo, UpdateSourceTrigger=PropertyChanged}"
                                                                             Background="#1A2535" Foreground="{DynamicResource AccentBrush}"
                                                                             FontWeight="SemiBold"
                                                                             BorderBrush="#44AACCFF" BorderThickness="0,0,0,1"
                                                                             Padding="4,1" VerticalAlignment="Center"
                                                                             PreviewKeyDown="HotkeyCapture_PreviewKeyDown"
                                                                             Tag="capture"/>
                                                                </DataTemplate>
                                                            </DataGridTemplateColumn.CellTemplate>
                                                        </DataGridTemplateColumn>
                                                        <DataGridTextColumn Header="Command"   Width="200" Binding="{Binding Command}"     IsReadOnly="True"/>
                                                        <DataGridTextColumn Header="Description" Width="*" Binding="{Binding Description}" IsReadOnly="True"/>
                                                    </DataGrid.Columns>
                                                </DataGrid>
                                            </Expander>

                                            <Expander Header="Tooltip Hotkeys" IsExpanded="False"
                                                      Foreground="White" Margin="0,0,0,8">
                                                <DataGrid ItemsSource="{Binding HotkeyEditor.TooltipHotkeys}"
                                                          AutoGenerateColumns="False" CanUserAddRows="False"
                                                          CanUserDeleteRows="False" HeadersVisibility="Column"
                                                          GridLinesVisibility="Horizontal"
                                                          Background="Transparent"
                                                          Foreground="White" BorderThickness="0"
                                                          ColumnHeaderHeight="28" RowHeight="30" Margin="0,4,0,0"
                                                          PreviewMouseWheel="HotkeyDataGrid_PreviewMouseWheel">
                                                    <DataGrid.RowStyle>
                                                        <Style TargetType="DataGridRow">
                                                            <Setter Property="Background" Value="#111820"/>
                                                            <Setter Property="Foreground" Value="White"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsDuplicate}" Value="True">
                                                                    <Setter Property="Background" Value="#4D1A0A"/>
                                                                    <Setter Property="Foreground" Value="#FF8080"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </DataGrid.RowStyle>
                                                    <DataGrid.Columns>
                                                        <DataGridTemplateColumn Header="Key Display" Width="140">
                                                            <DataGridTemplateColumn.CellTemplate>
                                                                <DataTemplate>
                                                                    <TextBox Text="{Binding KeyCombo, UpdateSourceTrigger=PropertyChanged}"
                                                                             Background="#1A2535" Foreground="{DynamicResource AccentBrush}"
                                                                             FontWeight="SemiBold"
                                                                             BorderBrush="#44AACCFF" BorderThickness="0,0,0,1"
                                                                             Padding="4,1" VerticalAlignment="Center"
                                                                             PreviewKeyDown="HotkeyCapture_PreviewKeyDown"
                                                                             Tag="capture"/>
                                                                </DataTemplate>
                                                            </DataGridTemplateColumn.CellTemplate>
                                                        </DataGridTemplateColumn>
                                                        <DataGridTextColumn Header="Command"     Width="200" Binding="{Binding Command}"     IsReadOnly="True"/>
                                                        <DataGridTextColumn Header="Description" Width="*"   Binding="{Binding Description}" IsReadOnly="True"/>
                                                    </DataGrid.Columns>
                                                </DataGrid>
                                            </Expander>

                                            <Expander Header="Debug Hotkeys" IsExpanded="False"
                                                      Foreground="White" Margin="0,0,0,8">
                                                <DataGrid ItemsSource="{Binding HotkeyEditor.DebugHotkeys}"
                                                          AutoGenerateColumns="False" CanUserAddRows="False"
                                                          CanUserDeleteRows="False" HeadersVisibility="Column"
                                                          GridLinesVisibility="Horizontal"
                                                          Background="Transparent"
                                                          Foreground="White" BorderThickness="0"
                                                          ColumnHeaderHeight="28" RowHeight="30" Margin="0,4,0,0"
                                                          PreviewMouseWheel="HotkeyDataGrid_PreviewMouseWheel">
                                                    <DataGrid.RowStyle>
                                                        <Style TargetType="DataGridRow">
                                                            <Setter Property="Background" Value="#111820"/>
                                                            <Setter Property="Foreground" Value="White"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsDuplicate}" Value="True">
                                                                    <Setter Property="Background" Value="#4D1A0A"/>
                                                                    <Setter Property="Foreground" Value="#FF8080"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </DataGrid.RowStyle>
                                                    <DataGrid.Columns>
                                                        <DataGridTemplateColumn Header="Key Binding" Width="140">
                                                            <DataGridTemplateColumn.CellTemplate>
                                                                <DataTemplate>
                                                                    <TextBox Text="{Binding KeyCombo, UpdateSourceTrigger=PropertyChanged}"
                                                                             Background="#1A2535" Foreground="{DynamicResource AccentBrush}"
                                                                             FontWeight="SemiBold"
                                                                             BorderBrush="#44AACCFF" BorderThickness="0,0,0,1"
                                                                             Padding="4,1" VerticalAlignment="Center"
                                                                             PreviewKeyDown="HotkeyCapture_PreviewKeyDown"
                                                                             Tag="capture"/>
                                                                </DataTemplate>
                                                            </DataGridTemplateColumn.CellTemplate>
                                                        </DataGridTemplateColumn>
                                                        <DataGridTextColumn Header="Command"     Width="200" Binding="{Binding Command}"     IsReadOnly="True"/>
                                                        <DataGridTextColumn Header="Description" Width="*"   Binding="{Binding Description}" IsReadOnly="True"/>
                                                    </DataGrid.Columns>
                                                </DataGrid>
                                            </Expander>
                                        </StackPanel>
                                    </ScrollViewer>

                                    <!-- Advanced mode: three Lua file sub-tabs -->
                                    <TabControl Grid.Row="2"
                                                Background="Transparent" BorderBrush="#33FFFFFF"
                                                Foreground="White"
                                                Visibility="{Binding HotkeyEditor.IsNormalAdvancedMode,
                                                    Converter={StaticResource BoolToVisConverter}}">
                                        <TabItem Header="defaultKeyMap.lua">
                                            <TextBox Text="{Binding HotkeyEditor.RawDefaultKeyMapText, UpdateSourceTrigger=PropertyChanged}"
                                                     AcceptsReturn="True" AcceptsTab="True"
                                                     FontFamily="Consolas" FontSize="12"
                                                     Background="#0D1117" Foreground="#DDDDDD"
                                                     BorderThickness="0"
                                                     VerticalScrollBarVisibility="Auto"
                                                     HorizontalScrollBarVisibility="Auto"
                                                     TextWrapping="NoWrap"/>
                                        </TabItem>
                                        <TabItem Header="keyactions.lua">
                                            <TextBox Text="{Binding HotkeyEditor.RawKeyActionsText, UpdateSourceTrigger=PropertyChanged}"
                                                     AcceptsReturn="True" AcceptsTab="True"
                                                     FontFamily="Consolas" FontSize="12"
                                                     Background="#0D1117" Foreground="#DDDDDD"
                                                     BorderThickness="0"
                                                     VerticalScrollBarVisibility="Auto"
                                                     HorizontalScrollBarVisibility="Auto"
                                                     TextWrapping="NoWrap"/>
                                        </TabItem>
                                        <TabItem Header="keydescriptions.lua">
                                            <TextBox Text="{Binding HotkeyEditor.RawKeyDescriptionsText, UpdateSourceTrigger=PropertyChanged}"
                                                     AcceptsReturn="True" AcceptsTab="True"
                                                     FontFamily="Consolas" FontSize="12"
                                                     Background="#0D1117" Foreground="#DDDDDD"
                                                     BorderThickness="0"
                                                     VerticalScrollBarVisibility="Auto"
                                                     HorizontalScrollBarVisibility="Auto"
                                                     TextWrapping="NoWrap"/>
                                        </TabItem>
                                    </TabControl>

                                    <!-- Action buttons -->
                                    <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="0,8,0,0">
                                        <Button Content="💾  Save &amp; Apply to Game"
                                                Style="{StaticResource PrimaryButton}"
                                                Margin="0,0,8,0"
                                                Click="SaveNormalHotkeys_Click"/>
                                        <Button Content="↩  Restore Original Keybindings"
                                                Style="{StaticResource ModernButton}"
                                                Margin="0,0,8,0"
                                                Click="RestoreNormalHotkeys_Click"/>
                                        <Button Content="🗑  Uninstall Mod"
                                                Style="{StaticResource DangerButton}"
                                                Click="UninstallNormalHotkeyMod_Click"/>
                                    </StackPanel>
                                </Grid>
                            </Grid>
                        </TabItem>

                        <!-- ══ TAB 2: Build Mode Hotkeys ════════════════════════════════════ -->
                        <TabItem Header="Build Mode Hotkeys  (BuildmodeHotkeys.scd)">
                            <Grid Margin="0,8,0,0">
                                <!-- NOT INSTALLED -->
                                <Border Style="{StaticResource ContentPanel}"
                                        Visibility="{Binding HotkeyEditor.IsBuildModeModInstalled, Converter={StaticResource InverseBoolToVisConverter}}">
                                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Width="460">
                                        <TextBlock Text="🏗  Build Mode Hotkey Mod Not Installed"
                                                   FontSize="18" FontWeight="SemiBold" Foreground="White"
                                                   HorizontalAlignment="Center" Margin="0,0,0,12"/>
                                        <TextBlock TextWrapping="Wrap" Foreground="#CCCCCC" FontSize="13"
                                                   HorizontalAlignment="Center" TextAlignment="Center" Margin="0,0,0,16">
                                            The build mode mod (BuildmodeHotkeys.scd) enables keyboard-only construction.
                                            Press B on an engineer or ACU to enter build mode.
                                            Click below and the mod manager will download and install it automatically.
                                        </TextBlock>
                                        <Button Content="⬇  Download &amp; Install"
                                                Style="{StaticResource PrimaryButton}"
                                                HorizontalAlignment="Center" Width="200"
                                                IsEnabled="{Binding HotkeyEditor.IsBuildModeDownloading, Converter={StaticResource InverseBoolConverter}}"
                                                Click="DownloadAndInstallBuildModeHotkey_Click"
                                                Visibility="{Binding HotkeyEditor.IsBuildModeDownloading, Converter={StaticResource InverseBoolToVisConverter}}"/>
                                        <TextBlock Text="Downloading..."
                                                   Foreground="{DynamicResource AccentBrush}" FontSize="14"
                                                   HorizontalAlignment="Center"
                                                   Visibility="{Binding HotkeyEditor.IsBuildModeDownloading, Converter={StaticResource BoolToVisConverter}}"/>
                                    </StackPanel>
                                </Border>

                                <!-- INSTALLED EDITOR -->
                                <Grid Visibility="{Binding HotkeyEditor.IsBuildModeModInstalled, Converter={StaticResource BoolToVisConverter}}">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="*"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>

                                    <!-- Instructions -->
                                    <Border Grid.Row="0" Background="#0D1A2A" BorderBrush="#22AACCFF" BorderThickness="1"
                                            CornerRadius="6" Padding="14,10" Margin="0,0,0,10">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="🏗" FontSize="22" VerticalAlignment="Center"
                                                       Foreground="{DynamicResource AccentBrush}" Margin="0,0,10,0"/>
                                            <StackPanel>
                                                <TextBlock Text="How to edit build mode hotkeys" Foreground="White" FontWeight="SemiBold" FontSize="13"/>
                                                <TextBlock Foreground="#AAAAAA" FontSize="12" Margin="0,3,0,0" TextWrapping="Wrap">
                                                    Select your faction, then click any <Run Foreground="{DynamicResource AccentBrush}" FontWeight="SemiBold">Key</Run> cell and type the new key (single uppercase letter, e.g. <Run Foreground="{DynamicResource AccentBrush}">D</Run>, <Run Foreground="{DynamicResource AccentBrush}">F</Run>).
                                                    The same key can be reused across different categories. Click <Run Foreground="{DynamicResource AccentBrush}" FontWeight="SemiBold">Save &amp; Apply to Game</Run> when done.
                                                </TextBlock>
                                            </StackPanel>
                                        </StackPanel>
                                    </Border>

                                    <!-- Mode toggle -->
                                    <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,8">
                                        <TextBlock Text="Mode:" Foreground="#AAAAAA" FontSize="13"
                                                   VerticalAlignment="Center" Margin="0,0,8,0"/>
                                        <RadioButton Content="Normal"
                                                     IsChecked="{Binding HotkeyEditor.IsBuildModeAdvancedMode,
                                                         Converter={StaticResource InverseBoolConverter}}"
                                                     Margin="0,0,12,0" VerticalAlignment="Center" Foreground="White"/>
                                        <RadioButton Content="Advanced (Raw Lua)"
                                                     IsChecked="{Binding HotkeyEditor.IsBuildModeAdvancedMode}"
                                                     VerticalAlignment="Center" Foreground="White"/>
                                    </StackPanel>

                                    <!-- Faction selector (Normal mode only) -->
                                    <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,0,0,8"
                                                Visibility="{Binding HotkeyEditor.IsBuildModeAdvancedMode,
                                                    Converter={StaticResource InverseBoolToVisConverter}}">
                                        <TextBlock Text="Faction:" Foreground="#AAAAAA" FontSize="13"
                                                   VerticalAlignment="Center" Margin="0,0,8,0"/>
                                        <RadioButton Content="UEF"       IsChecked="{Binding HotkeyEditor.IsUEFSelected}"
                                                     Margin="0,0,16,0" VerticalAlignment="Center" Foreground="White"/>
                                        <RadioButton Content="Cybran"    IsChecked="{Binding HotkeyEditor.IsCybranSelected}"
